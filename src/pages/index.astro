---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const featured = all.filter((p) => p.data.featured).slice(0, 4);
---

<Base>

  <!-- ==================== 首屏：红线帘 ==================== -->
  <section class="hero">
    <canvas class="curtain" data-curtain aria-hidden="true"></canvas>

    <!-- 九根挂作品的线。真链接，JS 只负责让它们跟着珠子走。 -->
    <nav class="labels" data-labels aria-label="Work, hanging on the threads">
      {all.map((p) => (
        <a class="tlabel" href={`/work/${p.id}`} data-label>
          <span class="tlabel-text">{p.data.title}</span>
        </a>
      ))}
    </nav>

    <div class="wrap hero-inner">
      <p class="hero-eyebrow mono">▶ MULTIDISCIPLINARY ARTIST &amp; DESIGNER — BOSTON</p>

      <h1 class="hero-title">
        I&rsquo;m <span class="hl">Red&nbsp;Line</span>.<br />
        I design, paint, tattoo,<br />
        and make games.
      </h1>

      <p class="hero-tail mono">
        ____&gt; a multi-hyphenate by passion &gt;&gt;__and&nbsp;by&nbsp;self-proclamation
      </p>
    </div>

    <p class="hero-hint mono">
      ▶ brush through the threads &mdash;&mdash; {all.length} of them carry work
    </p>

    <a href="#work" class="hero-cue mono" aria-label="Scroll to work">
      SCROLL <span class="cue-arrow">↓</span>
    </a>
  </section>

  <!-- ==================== 精选作品 ==================== -->
  <section id="work" class="section">
    <div class="wrap">

      <div class="head reveal">
        <h2 class="section-label">SELECTED WORK</h2>
        <a href="/work" class="head-all mono">ALL WORK <span class="index">[{all.length}]</span> →</a>
      </div>

      <div class="grid">
        {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>

    </div>
  </section>

  <!-- ==================== 简述 ==================== -->
  <section class="section about">
    <div class="wrap about-grid">

      <h2 class="section-label reveal">ABOUT</h2>

      <div class="about-body">
        <p class="prose reveal">
          Currently pursuing my Master&rsquo;s in Digital Media, I&rsquo;m exploring how
          traditional craft and modern technology collide to create tension,
          contradiction, and visual storytelling. My work lives somewhere between
          the <em>tangible</em> and the <em>unreal</em>, where myth, emotion, and
          data all intertwine.
        </p>
        <p class="prose reveal">
          I can help you turn abstract ideas into striking, story-driven visuals —
          whether it&rsquo;s brand design, illustration, or immersive media experiences
          that move people both visually and emotionally.
        </p>
        <a href="/info" class="about-more mono reveal">More about me →</a>
      </div>

    </div>
  </section>

</Base>

<script>
  import { initThreadCurtain } from '../scripts/thread-curtain.js';

  const canvas = document.querySelector('[data-curtain]');
  const wrap = document.querySelector('[data-labels]');

  if (canvas && wrap) {
    const links = [...wrap.querySelectorAll<HTMLAnchorElement>('[data-label]')].map((el) => ({
      el,
      href: el.getAttribute('href') ?? '/work',
    }));

    wrap.setAttribute('data-ready', '');
    initThreadCurtain(canvas as HTMLCanvasElement, links);
  }
</script>

<style>
  /* ==================== 首屏 ==================== */

  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }

  .curtain {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  /* --- 挂在线上的作品标签 --- */

  .labels {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* JS 接管之前先藏起来，避免所有标签堆在左上角 */
  .labels:not([data-ready]) .tlabel { visibility: hidden; }

  .tlabel {
    position: absolute;
    top: 0;
    left: 0;
    pointer-events: auto;
    /* 珠子画在 canvas 上，文字从珠子右侧展开 */
    padding: 0.35em 0.7em 0.35em 1.1em;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--ink);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    border: 1px solid var(--line);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity 0.28s var(--ease);
  }

  .tlabel.is-on,
  .tlabel:focus-visible { opacity: 1; }

  /* 右侧的标签往左展开，不出界 */
  .tlabel.flip {
    transform-origin: right center;
    margin-left: -100%;
    padding: 0.35em 1.1em 0.35em 0.7em;
    text-align: right;
  }

  /* --- 文案 --- */

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: 4rem;
    pointer-events: none;   /* 让光标能穿过文字去拨线 */
  }

  /* 文字后面垫一层纸色，压住背后的线保证可读 */
  .hero-inner::before {
    content: '';
    position: absolute;
    inset: -8% -12% -14% -6%;
    z-index: -1;
    background: radial-gradient(
      70% 60% at 24% 50%,
      color-mix(in srgb, var(--paper) 94%, transparent) 0%,
      color-mix(in srgb, var(--paper) 78%, transparent) 42%,
      transparent 78%
    );
  }

  .hero-eyebrow {
    color: var(--ink-soft);
    letter-spacing: 0.16em;
  }

  .hero-title {
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-4);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hl { color: var(--red); }

  .hero-tail {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  /* --- 提示与滚动指示 --- */

  .hero-hint {
    position: absolute;
    z-index: 1;
    left: var(--gutter);
    bottom: 4.5rem;
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-transform: none;
    pointer-events: none;
  }

  .hero-cue {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    bottom: 2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--ink-faint);
    letter-spacing: 0.18em;
    transition: color 0.25s var(--ease);
  }

  .hero-cue:hover { color: var(--red); }

  .cue-arrow {
    display: inline-block;
    animation: bob 2.4s var(--ease) infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50%      { transform: translateY(5px); opacity: 1; }
  }

  @media (max-width: 640px) {
    .hero-hint { display: none; }
  }

  /* ==================== 精选 ==================== */

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 1.1rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .head-all {
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    text-transform: none;
    transition: color 0.2s var(--ease);
  }

  .head-all:hover { color: var(--red); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  /* ==================== 简述 ==================== */

  .about { border-top: 1px solid var(--line); }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .about-body > * + * { margin-top: 1.4rem; }

  .about-more {
    display: inline-block;
    color: var(--ink-soft);
    letter-spacing: 0.1em;
    text-transform: none;
    transition: color 0.2s var(--ease);
  }

  .about-more:hover { color: var(--red); }

  @media (max-width: 720px) {
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
