---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);

  const sorted = projects.sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    return b.data.year.localeCompare(a.data.year);
  });

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, titleCn, year, categories, summary, cover, coverAlt, meta } = project.data;
const { Content } = await render(project);
---

<Base title={`${title} — 红线 RED LINE`} description={summary}>

  <!-- ==================== 标题区 ==================== -->
  <article>
    <header class="head">
      <div class="wrap">

        <a href="/work" class="back mono">← WORK</a>

        <h1 class="title">
          {title}
          {titleCn && <span class="title-cn">{titleCn}</span>}
        </h1>

        <p class="lede prose">{summary}</p>

        <!-- 等宽元信息块 —— 终端感的来源 -->
        <dl class="meta">
          <div class="meta-row">
            <dt class="mono">year</dt>
            <dd class="mono">{year}</dd>
          </div>
          <div class="meta-row">
            <dt class="mono">category</dt>
            <dd class="mono">{categories.join(' · ')}</dd>
          </div>
          {meta && Object.entries(meta).map(([k, v]) => (
            <div class="meta-row">
              <dt class="mono">{k}</dt>
              <dd class="mono">{v}</dd>
            </div>
          ))}
        </dl>

      </div>
    </header>

    {cover && (
      <figure class="cover">
        <div class="wrap">
          <img src={cover} alt={coverAlt ?? title} />
        </div>
      </figure>
    )}

    <!-- ==================== 正文 ==================== -->
    <div class="body">
      <div class="wrap">
        <div class="prose-body">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- ==================== 上一件 / 下一件 ==================== -->
  <nav class="pager">
    <div class="wrap">
      <hr class="rule" />
      <div class="pager-row">
        {prev ? (
          <a class="pager-link is-prev" href={`/work/${prev.id}`}>
            <span class="mono pager-dir">← 上一件</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : <span />}

        {next ? (
          <a class="pager-link is-next" href={`/work/${next.id}`}>
            <span class="mono pager-dir">下一件 →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </div>
    </div>
  </nav>

</Base>

<style>
  /* ==================== 标题区 ==================== */

  .head {
    padding-top: clamp(6.5rem, 13vw, 10rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .back {
    display: inline-block;
    color: var(--ink-faint);
    letter-spacing: 0.16em;
    transition: color 0.2s var(--ease);
  }

  .back:hover { color: var(--red); }

  .title {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.032em;
    max-width: 20ch;
    text-wrap: balance;
  }

  .title-cn {
    display: block;
    margin-top: 0.3em;
    font-size: 0.42em;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .lede {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  /* --- 元信息 --- */

  .meta {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--line);
    max-width: 46rem;
  }

  .meta-row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--line);
  }

  .meta-row dt {
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }

  .meta-row dd {
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (max-width: 560px) {
    .meta-row { grid-template-columns: 1fr; gap: 0.15rem; }
  }

  /* ==================== 封面 ==================== */

  .cover { margin-block: clamp(1.5rem, 4vw, 3rem); }

  .cover img {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  /* ==================== 正文 ==================== */

  .body { padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 9vw, 7rem); }

  /* Markdown 渲染出来的内容 —— 长文用衬线，小标题用等宽 */
  .prose-body :global(p) {
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.74;
    max-width: var(--measure);
  }

  .prose-body :global(p + p) { margin-top: 1.1em; }

  /* 章节标题：# A / ## MATERIAL EXPERIMENT 这类 */
  .prose-body :global(h2) {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .prose-body :global(h2)::before {
    content: '▶ ';
    color: var(--red);
  }

  .prose-body :global(h2 + p) { margin-top: 1.4rem; }

  .prose-body :global(h3) {
    margin-top: 2.2rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .prose-body :global(h3 + p) { margin-top: 0.7rem; }

  .prose-body :global(img) {
    width: 100%;
    margin-block: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  .prose-body :global(em) { font-style: italic; }
  .prose-body :global(strong) { font-weight: 600; }

  .prose-body :global(a) {
    border-bottom: 1px solid var(--red);
    transition: background 0.2s var(--ease);
  }
  .prose-body :global(a:hover) { background: var(--red-wash); }

  .prose-body :global(blockquote) {
    margin-block: 2rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--red);
    font-family: var(--font-prose);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .prose-body :global(ul) {
    margin-top: 1.1em;
    max-width: var(--measure);
  }

  .prose-body :global(li) {
    position: relative;
    padding-left: 1.4em;
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.7;
  }

  .prose-body :global(li + li) { margin-top: 0.4em; }

  .prose-body :global(li)::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--red);
  }

  .prose-body :global(hr) {
    margin-block: clamp(2.5rem, 6vw, 4rem);
    height: 1px;
    background: var(--line);
    border: 0;
  }

  /* ==================== 翻页 ==================== */

  .pager { padding-bottom: 1rem; }

  .pager-row {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.5rem;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 22ch;
  }

  .is-next { text-align: right; }

  .pager-dir {
    color: var(--ink-faint);
    letter-spacing: 0.12em;
    text-transform: none;
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    transition: color 0.2s var(--ease);
  }

  .pager-link:hover .pager-title { color: var(--red); }
</style>
