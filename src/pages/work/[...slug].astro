---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HeroGallery from '../../components/HeroGallery.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);

  const sorted = projects.sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    return b.data.year.localeCompare(a.data.year);
  });

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, year, categories, summary, cover, coverAlt, meta, gallery, links, status } = project.data;
const { Content, headings } = await render(project);

/* 章节索引：只取 ## 这一级，长案例才值得放 */
const sections = headings.filter((h) => h.depth === 2);

/* 开屏只认「00 封面」里的画廊图。
   cover 是列表页的缩略图，尺寸和构图都是按 4:3 卡片挑的，
   拿它顶一张满屏开屏并不合适 —— 没放画廊图就干脆不要开屏。 */
const slides = gallery ?? [];

/* 分享预览图：画廊里第一张图 */
const shareImage = cover?.src ?? gallery?.find((s) => s.image)?.image?.src;

/* ---- 卷宗编号 ----
   从 slug 首字母 + 序号推出来，不用另外维护字段。
   eden-of-east / 9 → RT-EOE-009，页眉和页脚都用它。 */
const refOf = (p: { id: string; data: { order?: number } }) =>
  `RT-${p.id.split('-').map((w) => w[0]).join('').toUpperCase().slice(0, 3)}-` +
  String(p.data.order ?? 0).padStart(3, '0');

const caseNo = String(project.data.order ?? 0).padStart(3, '0');
const ref = refOf(project);

/* 页眉右侧的日期区间：meta.date 有就用，没有就退回年份 */
const span = (meta as Record<string, string> | undefined)?.date ?? year;
---

<Base title={`${title} — Red Thread`} description={summary} image={shareImage} type="article">

  <!-- ==================== 开屏：全屏画廊 ==================== -->
  <article>
    {slides.length > 0 && <HeroGallery slides={slides} title={title} />}

    <header class:list={['head', { 'has-shot': slides.length > 0 }]}>
      <div class="wrap">

        <!-- 页眉横栏：一本正经的档案抬头 -->
        <div class="rail rail-top">
          <a href="/work" class="rail-cell back">← RETURN</a>
          <span class="rail-cell">CASE FILE</span>
          <span class="rail-cell">{categories.join(' / ')}</span>
          {status && <span class="rail-cell is-status">STATUS: {status}</span>}
          <span class="rail-cell rail-end">{span}</span>
        </div>

        <!-- 编号行：编号 · 品名 · 序号 -->
        <div class="slug-line">
          <span class="ref">{ref}</span>
          <h1 class="title">{title}</h1>
          <span class="hash">#{caseNo}</span>
        </div>

        <p class="lede">{summary}</p>

        <!-- 检验表：横向分栏，不是竖着的键值对 -->
        <dl class="spec">
          <div class="spec-col">
            <dt>Année</dt>
            <dd>{year}</dd>
          </div>
          {meta && Object.entries(meta).map(([k, v]) => (
            <div class="spec-col">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>

        {links && links.length > 0 && (
          <ul class="extlinks">
            {links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label}<span class="arrow">&#8599;</span>
                  <span class="host">{new URL(l.href).host.replace(/^www\./, '')}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

      </div>
    </header>

    <!-- ==================== 章节索引 ==================== -->
    {sections.length > 2 && (
      <nav class="sections" aria-label="Sections">
        <div class="wrap">
          <ul class="sec-list" data-sections>
            {sections.map((h) => (
              <li>
                <a class="sec-link mono" href={`#${h.slug}`} data-sec={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}

    <!-- ==================== 正文 ==================== -->
    <div class="body">
      <div class="wrap">
        <!-- 页边竖排卷宗号，只在够宽的屏幕出现 -->
        <span class="folio" aria-hidden="true">{ref}</span>
        <div class="prose-body">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- ==================== 上一件 / 下一件 ==================== -->
  <nav class="pager">
    <div class="wrap">
      <hr class="rule" />
      <div class="pager-row">
        {prev ? (
          <a class="pager-link is-prev" href={`/work/${prev.id}`}>
            <span class="pager-dir">← {refOf(prev)}</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : <span />}

        {next ? (
          <a class="pager-link is-next" href={`/work/${next.id}`}>
            <span class="pager-dir">{refOf(next)} →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </div>
    </div>
  </nav>

</Base>

<script>
  const body = document.querySelector<HTMLElement>('.prose-body');

  /* ---- 1. 子小节改成两栏：标题和说明在左，图在右 ----
     ### 底下往往只有三四张小图，标题独占一行太浪费高度。 */
  if (body) {
    let head: HTMLElement | null = null;
    let main: HTMLElement | null = null;

    for (const el of [...body.children] as HTMLElement[]) {
      if (el.tagName === 'H3') {
        const sub = document.createElement('section');
        sub.className = 'sub';
        head = document.createElement('div');
        head.className = 'sub-head';
        main = document.createElement('div');
        main.className = 'sub-main';
        sub.append(head, main);
        el.replaceWith(sub);
        head.append(el);
        continue;
      }
      if (!head || !main) continue;
      if (el.tagName === 'H2') { head = main = null; continue; }
      /* 纯文字说明跟着标题走，图和列表进右栏 */
      if (el.tagName === 'P' && !el.querySelector('img')) head.append(el);
      else main.append(el);
    }
  }

  /* ---- 1b. 还没有素材的小节 ----
     空标题后面跟一片空白，读起来像页面坏了。
     卷宗里这种情况本来就有写法 —— 封面缺图时写 NO PLATE ON FILE，
     这里沿用同一句式：与其假装没有这一节，不如写明在等素材。
     文件夹里一丢进图，import 脚本填上内容，这行自己就没了。 */
  body?.querySelectorAll<HTMLElement>('.sub').forEach((sub) => {
    const main = sub.querySelector<HTMLElement>('.sub-main');
    if (!main || main.children.length) return;
    const note = document.createElement('p');
    note.className = 'sub-pending mono';
    note.textContent = 'NO MATERIAL ON FILE';
    main.append(note);
  });

  /* ---- 2. 过程图的横向滑动带 ----
     鼠标可以直接按住拖，触控板/触屏本来就能横滑。 */
  /* 按原始比例把图分栏：同一栏统一宽度、竖着摞满整条高度，
     所以栏内不会有窄图留下的空档，栏与栏之间也齐平。 */
  const layoutStrip = (strip: HTMLElement) => {
    const items: HTMLElement[] = (strip as any)._items
      ?? ((strip as any)._items = [...strip.querySelectorAll<HTMLElement>(':scope > p')]);
    if (!items.length) return;

    /* 先把图全倒回来，拆掉上一次分的栏 */
    strip.append(...items);
    strip.querySelectorAll('.strip-col').forEach((c) => c.remove());

    /* 图和视频都要认 —— 只找 img 的话，混排的视频会让整段崩掉 */
    const ratio = items.map((p) => {
      const el = p.querySelector<HTMLImageElement | HTMLVideoElement>('img, video');
      if (!el) return 1;
      const w = Number(el.getAttribute('width'))
        || (el as HTMLImageElement).naturalWidth
        || (el as HTMLVideoElement).videoWidth
        || 1;
      const h = Number(el.getAttribute('height'))
        || (el as HTMLImageElement).naturalHeight
        || (el as HTMLVideoElement).videoHeight
        || 1;
      return w / h;
    });

    const gap = parseFloat(getComputedStyle(strip).rowGap) || 6;

    /* 后台标签页里 innerHeight / clientWidth 会是 0，算出来整条塌成 0 高。
       兜底给个下限，等真正可见时再重排一次。 */
    const vh = innerHeight || document.documentElement.clientHeight || 800;
    const cw = strip.clientWidth || strip.parentElement?.clientWidth || 1200;

    const band = Math.max(320, Math.min(vh * 0.72, 780));
    const narrow = cw < 700;
    /* 目标栏宽：手机上约占七成屏宽，桌面上约占三成六。
       过程图也是作品，宁可少看几张也要看得清。 */
    const target = narrow
      ? cw * 0.72
      : Math.max(280, Math.min(cw * 0.36, 520));

    /* 每栏松紧不同才有节奏：宽的那栏只放一两张大图，紧的那栏摞三张小的。
       手机屏窄，节奏收敛一点，否则最紧的那栏会摞出四张指甲盖。 */
    const RHYTHM = narrow
      ? [1.3, 0.86, 1.0, 0.8]
      : [1.45, 0.78, 1.0, 0.62];

    const cols: { at: number[]; w: number }[] = [];
    let at: number[] = [];
    let inv = 0;

    items.forEach((_, i) => {
      at.push(i);
      inv += 1 / ratio[i];
      const w = (band - gap * (at.length - 1)) / inv;
      if (w <= target * RHYTHM[cols.length % RHYTHM.length]) {
        cols.push({ at, w });
        at = [];
        inv = 0;
      }
    });

    /* 收尾那一栏可能摞不满，宽度封顶，别让一张横图撑得离谱 */
    if (at.length) {
      cols.push({ at, w: Math.min((band - gap * (at.length - 1)) / inv, target * 1.4) });
    }

    for (const c of cols) {
      const col = document.createElement('div');
      col.className = 'strip-col';
      col.style.width = `${Math.round(c.w)}px`;
      c.at.forEach((i) => col.append(items[i]));
      strip.append(col);
    }
  };

  document.querySelectorAll<HTMLElement>('.strip, .slider').forEach((strip) => {
    const n = strip.querySelectorAll('img').length;
    strip.tabIndex = 0;
    strip.setAttribute('role', 'group');
    strip.setAttribute('aria-label', `${n} images, scroll sideways`);

    const isSlider = strip.classList.contains('slider');
    if (!isSlider) layoutStrip(strip);

    let t = 0;
    const relayout = () => {
      clearTimeout(t);
      if (!isSlider) t = window.setTimeout(() => layoutStrip(strip), 150);
    };
    addEventListener('resize', relayout);
    /* 从后台切回前台时视口尺寸才真正确定，补排一次 */
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) relayout();
    });

    let down = false;
    let startX = 0;
    let startLeft = 0;
    let moved = false;

    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;    // 触屏交给系统自己滚
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = strip.scrollLeft;
      strip.classList.add('is-dragging');
    });

    strip.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      strip.scrollLeft = startLeft - dx;
    });

    const end = () => {
      down = false;
      strip.classList.remove('is-dragging');
    };
    strip.addEventListener('pointerup', end);
    strip.addEventListener('pointerleave', end);

    /* 拖完别把最后停下的那张图当成点击 */
    strip.addEventListener('click', (e) => { if (moved) e.preventDefault(); }, true);

    /* 滑到头了就把提示收掉 */
    const hint = () => {
      const more = strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 8;
      strip.classList.toggle('has-more', more);
    };
    strip.addEventListener('scroll', hint, { passive: true });
    new ResizeObserver(hint).observe(strip);
    hint();
  });

  /* ---- 2b. 混排的视频：进视野才播，离开就停 ----
     不这么做的话一页几十个视频会同时解码，手机直接卡死。
     点一下切声音 —— 浏览器不允许带声自播，所以默认静音。 */
  /* ---- YouTube 外链片子 ----
     先只放一张缩略图和一个播放标记，点了才把播放器塞进来。
     一进页面就挂 iframe 的话，YouTube 的脚本、cookie 和几百 KB
     会跟着整页一起加载 —— 一节里放两个就够让页面卡一下。
     域名用 youtube-nocookie，点播放之前不写跟踪 cookie。 */
  document.querySelectorAll<HTMLElement>('[data-tube]').forEach((box) => {
    const id = box.dataset.tube;
    if (!id) return;
    const poster = document.createElement('img');
    poster.src = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
    poster.alt = '';
    poster.loading = 'lazy';
    poster.decoding = 'async';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'tube-play';
    btn.setAttribute('aria-label', box.dataset.tubeLabel || 'Play video');
    box.prepend(poster, btn);

    const open = () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      f.title = box.dataset.tubeLabel || 'Video';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      box.textContent = '';
      box.append(f);
    };
    btn.addEventListener('click', open);
  });

  const inlineVideos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');

  if (inlineVideos.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const watch = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting && !reduced) v.play().catch(() => {});
          else v.pause();
        }
      },
      { rootMargin: '10% 0px' },
    );

    for (const v of inlineVideos) {
      watch.observe(v);
      v.addEventListener('click', () => {
        v.muted = !v.muted;
        /* 开了声音就把别的静音，不然满页在响 */
        if (!v.muted) {
          for (const o of inlineVideos) if (o !== v) o.muted = true;
          v.play().catch(() => {});
        }
      });
      v.style.cursor = 'pointer';
    }
  }

  /* ---- 3. 章节索引跟着滚动高亮 ---- */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-sec]')];

  if (links.length) {
    const byId = new Map(links.map((a) => [a.dataset.sec!, a]));
    const seen = new Set<string>();
    const list = document.querySelector<HTMLElement>('[data-sections]');

    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) seen.add(e.target.id);
          else seen.delete(e.target.id);
        }
        /* 视野里最靠上的那节算当前节 */
        const current = links.find((a) => seen.has(a.dataset.sec!));
        links.forEach((a) => a.classList.toggle('is-on', a === current));

        /* 只横向挪索引条本身。用 scrollIntoView 会连整页一起滚，把人拽走。 */
        if (current && list) {
          const l = current.offsetLeft;
          const r = l + current.offsetWidth;
          if (l < list.scrollLeft || r > list.scrollLeft + list.clientWidth) {
            list.scrollTo({ left: l - 12, behavior: 'smooth' });
          }
        }
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );

    for (const id of byId.keys()) {
      const h = document.getElementById(id);
      if (h) spy.observe(h);
    }
  }
</script>

<style>
  /* ==================== 标题区 ==================== */

  .head {
    padding-top: clamp(6.5rem, 13vw, 10rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  /* 有开屏图时标题区不用再留那么高的顶部空白 */
  .head.has-shot {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* --- 页眉横栏：档案抬头，发丝线上下夹住 --- */

  .rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
    padding-block: 0.4rem;
    border-block: 1px solid var(--ink);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .rail-top { border-bottom-width: 0; }

  .rail-end { margin-left: auto; font-variant-numeric: tabular-nums; }

  /* 进行中的项目：状态是全栏唯一的红字 */
  .is-status { color: var(--red); }

  a.rail-cell {
    color: var(--ink-faint);
    transition: color 0.2s var(--ease);
  }

  a.rail-cell:hover { color: var(--red); }

  /* --- 编号行：编号 · 品名 · 序号 --- */

  .slug-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem clamp(0.9rem, 3vw, 2.5rem);
    padding-top: 0.5rem;
    padding-bottom: clamp(1rem, 2.5vw, 1.6rem);
    border-top: 1px solid var(--ink);
  }

  .ref,
  .hash {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .hash { margin-left: auto; color: var(--red); }

  .title {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.012em;
    text-transform: uppercase;
  }

  .lede {
    max-width: 62ch;
    font-size: var(--step-0);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  /* --- 检验表：横向分栏，跟参考的 Nom / Fichier / Donnée 一个读法 --- */

  .spec {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0 clamp(0.75rem, 2vw, 2rem);
    border-top: 1px solid var(--ink);
    padding-top: 0.35rem;
  }

  .spec-col {
    padding-bottom: 0.6rem;
    font-size: var(--step--1);
    line-height: 1.45;
  }

  .spec-col dt {
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .spec-col dd {
    margin: 0;
    color: var(--ink);
  }

  /* ==================== 封面 ==================== */

  .cover { margin-block: clamp(1.5rem, 4vw, 3rem); }

  .cover img {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  /* --- 外链：源码、demo、文档 --- */

  .extlinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.8rem;
    margin-top: 1rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--line);
  }

  .extlinks a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    font-size: var(--step--1);
    font-stretch: var(--cond);
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink);
    transition: color 0.2s var(--ease);
  }

  .extlinks a:hover { color: var(--red); }

  .extlinks .arrow { font-size: 0.85em; color: var(--red); }

  .extlinks .host {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-faint);
  }

  /* ==================== 章节索引 ==================== */

  .sections {
    position: sticky;
    top: var(--nav-h, 3.4rem);
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--line);
  }

  .sec-list {
    display: flex;
    gap: 0.35rem;
    padding-block: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .sec-list::-webkit-scrollbar { display: none; }

  .sec-link {
    display: block;
    white-space: nowrap;
    padding: 0.35em 0.7em;
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid transparent;
    /* 放大走 scale 而不是 font-size：字号一变，这一条的宽度跟着变，
       后面所有项都会横向跳一下，滚着页面看就是一路抽搐。
       scale 不影响布局，旁边的项纹丝不动。 */
    transform-origin: left center;
    transition: color 0.2s var(--ease),
                border-color 0.2s var(--ease),
                scale 0.25s var(--ease);
  }

  .sec-link:hover { color: var(--ink); }

  .sec-link.is-on {
    color: var(--red);
    border-color: var(--red);
    scale: 1.22;
  }

  /* 放大之后它会往右压到下一项，给它留出这部分宽度 */
  .sec-list li:has(.is-on) { padding-right: 1.1rem; }

  @media (prefers-reduced-motion: reduce) {
    .sec-link { transition: color 0.2s var(--ease), border-color 0.2s var(--ease); }
  }

  /* ==================== 正文 ==================== */

  .body {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 9vw, 7rem);
  }

  .body .wrap { position: relative; }

  /* --- 页边竖排卷宗号 ---
     跟着正文一起滚，压在留白里。窄屏直接不出现：
     rotate 不影响布局盒，放在小屏上会把页面撑宽。 */
  .folio {
    display: none;
    position: absolute;
    top: 0;
    /* 贴内容框右缘，不能伸进 gutter —— 伸出去就会把页面撑宽 */
    right: 0;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 3.2vw, 3.25rem);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--line);
    pointer-events: none;
    user-select: none;
  }

  @media (min-width: 1180px) {
    .folio { display: block; }
  }

  /* 锚点跳转时别被吸顶的导航和索引条挡住 */
  .prose-body :global(h2) { scroll-margin-top: calc(var(--nav-h, 3.4rem) + 3.5rem); }

  /* Markdown 渲染出来的内容 —— 长文用衬线，小标题用等宽。
     作品集是看图的，正文压到一栏窄字，让位给图。 */
  .prose-body :global(p) {
    font-family: var(--font-prose);
    font-size: var(--step-0);
    line-height: 1.7;
    max-width: 56ch;
    color: var(--ink-soft);
  }

  /* 开篇第一段仍然当引言，稍微重一点 */
  .prose-body > :global(p:first-child) {
    font-size: var(--step-1);
    line-height: 1.66;
    color: var(--ink);
    max-width: 62ch;
  }

  .prose-body :global(strong) { color: var(--ink); }

  /* 装图的段落不受字宽限制 —— 否则大图会被 56ch 截住 */
  .prose-body :global(p:has(img)) { max-width: none; }

  .prose-body :global(p + p) { margin-top: 1.1em; }

  /* 章节标题：整条发丝线压底，编号计数器挂在右侧页边 */
  .prose-body { counter-reset: sheet; }

  .prose-body :global(h2) {
    position: relative;
    counter-increment: sheet;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
    /* 章节标题是正文的路标，之前比正文还小一档，
       扫页面时根本抓不住。字距随字号变大要收一点，
       不然拉开的字母会把这一行读散。 */
    font-size: var(--step-1);
    font-stretch: var(--cond);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* 每节右端的张数编号 —— 数字是 CSS 数出来的，不是我写死的 */
  .prose-body :global(h2)::after {
    content: 'SHEET ' counter(sheet, decimal-leading-zero);
    position: absolute;
    right: 0;
    bottom: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  @media (max-width: 560px) {
    .prose-body :global(h2)::after { display: none; }
  }



  .prose-body :global(h2 + p) { margin-top: 1.4rem; }

  .prose-body :global(h3) {
    margin-top: 2.2rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .prose-body :global(h3 + p) { margin-top: 0.7rem; }

  .prose-body :global(img) {
    width: 100%;
    height: auto;
    margin-block: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  /* ---- 正文里的排版工具 ----
     在 md 里直接写 <div class="grid-2"> 就能用，详见 README。 */

  /* 用多栏而不是 grid：图按上传时的原始比例呈现，高度参差也不会留空档。
     2:1 就是 2:1，竖图就是竖图，一律不裁。 */
  .prose-body :global(.grid-2),
  .prose-body :global(.grid-3),
  .prose-body :global(.grid-4) {
    column-gap: clamp(0.6rem, 1.6vw, 1.1rem);
    margin-block: clamp(1.75rem, 4vw, 3rem);
    /* 网格整体比正文宽 —— 正文是给人读的，图是给人看的 */
    width: min(100%, 1180px);
  }

  .prose-body :global(.grid-2) { column-count: 2; }
  .prose-body :global(.grid-3) { column-count: 3; }
  .prose-body :global(.grid-4) { column-count: 4; }

  /* 每张图是一个栏内块，不许被拆到两栏去 */
  /* grid-N 是多栏，先填满第一栏才换下一栏 —— 四张图排出来是
     1 3 / 2 4，不是 1 2 / 3 4。图各自独立时无所谓，但一组按顺序
     看的过程图就读错了。
     rows-N 用真正的栅格，逐行排，顺序就是画面上的顺序。代价是同一行
     会对齐到最高的那张，比例参差时下面留空 —— 所以只在一组图比例
     一致时用它，其余情况还是交给 grid-N。 */
  .prose-body :global(.rows-2),
  .prose-body :global(.rows-3) {
    display: grid;
    gap: clamp(0.6rem, 1.6vw, 1.1rem);
    align-items: start;
    margin-block: clamp(1.75rem, 4vw, 3rem);
    width: min(100%, 1180px);
  }

  .prose-body :global(.rows-2) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .prose-body :global(.rows-3) { grid-template-columns: repeat(3, minmax(0, 1fr)); }

  @media (max-width: 640px) {
    .prose-body :global(.rows-2),
    .prose-body :global(.rows-3) { grid-template-columns: minmax(0, 1fr); }
  }

  .prose-body :global([class^='grid-'] p) {
    margin: 0 0 clamp(0.6rem, 1.6vw, 1.1rem);
    position: relative;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .prose-body :global([class^='rows-'] p) {
    margin: 0;
    position: relative;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .prose-body :global([class^='rows-'] img),
  .prose-body :global([class^='grid-'] img) {
    margin: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  /* 网格里只剩一张图时，别让它缩在一栏里 */
  .prose-body :global([class^='grid-']:has(> p:only-child)) {
    column-count: 1;
    width: min(100%, 560px);
  }

  /* 悬停微微放大并浮起，方便看清小图 */
  @media (hover: hover) and (pointer: fine) {
    .prose-body :global([class^='rows-'] p:hover),
    .prose-body :global([class^='grid-'] p:hover) {
      transform: scale(1.045);
      z-index: 2;
      box-shadow: 0 8px 26px rgba(23, 22, 20, 0.16);
    }
  }

  @media (max-width: 900px) {
    .prose-body :global(.grid-4) { column-count: 3; }
  }

  @media (max-width: 640px) {
    .prose-body :global(.grid-3),
    .prose-body :global(.grid-4) { column-count: 2; }
  }

  /* 通栏大图：冲破正文宽度铺满视口，用来放主视觉 */
  .prose-body :global(.full) {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .prose-body :global(.full p) { margin: 0; }

  /* 一节里有多张超宽图时，彼此之间留一道间距 */
  .prose-body :global(.full p + p) { margin-top: clamp(1rem, 2.5vw, 2rem); }

  .prose-body :global(.full video) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--ink);
  }

  .prose-body :global(.full img) {
    margin: 0;
    border-inline: 0;
  }

  /* ---- 成品：大而直接 ----
     冲破正文宽度，两列大图，高度错落用多栏自然填满。 */
  .prose-body :global(.showcase) {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(2.5rem, 6vw, 4.5rem);
    padding-inline: clamp(0.75rem, 3vw, 3rem);
    column-width: 640px;
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .prose-body :global(.showcase p) {
    margin: 0 0 clamp(0.75rem, 2vw, 1.5rem);
    break-inside: avoid;
  }

  .prose-body :global(.showcase img) {
    margin: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  /* 只有一张成品时不分栏，居中放到最大 */
  .prose-body :global(.showcase:has(> p:only-child)) {
    column-width: auto;
    column-count: 1;
    max-width: 1100px;
    margin-inline: auto;
  }

  @media (max-width: 760px) {
    .prose-body :global(.showcase) { column-width: auto; column-count: 1; }
  }

  /* ---- 滑动组：每张占满一屏宽，左右滑着看 ----
     用在「两三张都想给到通栏尺寸，但不想让页面变得很长」的时候。 */
  .prose-body :global(.slider) {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(2rem, 5vw, 3.5rem);
    display: flex;
    gap: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    cursor: grab;
  }

  .prose-body :global(.slider.is-dragging) { cursor: grabbing; scroll-snap-type: none; }

  .prose-body :global(.slider > p) {
    margin: 0;
    max-width: none;
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  .prose-body :global(.slider img),
  .prose-body :global(.slider video) {
    margin: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---- 卡牌阵：手排的整齐方阵 ----
     左边 5 栏 × 2 排放十张牌，右边两格（牌背和视频）各占满两排高、更大。
     用 grid 不用多栏，因为要的是「每排正好五张」，多栏是按高度分的。 */
  .prose-body :global(.cards) {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(2rem, 5vw, 3.5rem);
    padding-inline: clamp(0.75rem, 3vw, 3rem);
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr)) repeat(2, minmax(0, 1.32fr));
    gap: clamp(0.5rem, 1.4vw, 1rem);
    align-items: start;
    /* 窄屏放不下就左右滑，不硬挤 */
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }

  .prose-body :global(.cards p) { margin: 0; max-width: none; }

  /* 最后两格钉死在右边两栏、各占满两排高。
     它们先被显式放置，剩下的十张牌就自动流进左边 5×2 的格子里。 */
  .prose-body :global(.cards p:nth-last-child(2)) {
    grid-column: 6;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .prose-body :global(.cards p:last-child) {
    grid-column: 7;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .prose-body :global(.cards img),
  .prose-body :global(.cards video) {
    margin: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1100px) {
    /* 窄屏保持同一套结构，靠横向滑动看全 */
    .prose-body :global(.cards) {
      grid-template-columns: repeat(5, minmax(150px, 1fr)) repeat(2, minmax(200px, 1.32fr));
    }
  }

  /* ==================== 正文里的图表 ====================
     用发丝线和等宽字画，不用发光和圆角 —— 跟全站的档案风格保持一致。
     节点是方的，箭头是排版符号，红色只给关键路径。 */

  .prose-body :global(.dg) {
    width: min(100%, 1180px);
    margin-block: clamp(1.75rem, 4vw, 3rem);
    border-top: 1px solid var(--ink);
    padding-top: 1rem;
  }

  /* --- 单个节点 --- */
  .prose-body :global(.dg-node) {
    border: 1px solid var(--line-strong);
    background: var(--paper-raised);
    padding: 0.5rem 0.7rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    line-height: 1.35;
    color: var(--ink);
  }

  .prose-body :global(.dg-node b) {
    display: block;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .prose-body :global(.dg-node i) {
    display: block;
    margin-top: 0.2em;
    font-style: normal;
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-stretch: var(--cond);
    color: var(--ink-faint);
  }

  /* 关键路径上的节点：红边 */
  .prose-body :global(.dg-node.key) {
    border-color: var(--red);
    color: var(--red);
  }

  /* --- 竖向流程：节点之间用一根竖线连 --- */
  /* ---- YouTube 外链片子 ----
     开屏用自托管的短剪辑（有 25MiB 的单文件上限），
     完整的长片放这里 —— 十分钟的东西塞进 25MiB 只能是色块，
     那种长度交给 YouTube 的自适应码流是对的。 */
  .prose-body :global(.tube) {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 0;
    overflow: hidden;
    background: var(--paper-sunk);
    border: 1px solid var(--line);
  }

  .prose-body :global(.tube img),
  .prose-body :global(.tube iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    /* 正文里的图有外边距做行距，而外边距对绝对定位的元素照样生效 ——
       不清掉的话缩略图会被往下推，盒子顶上露一条底色。 */
    margin: 0;
  }

  .prose-body :global(.tube img) { object-fit: cover; }

  /* 播放标记：和导航栏一样的实心红点，中间一个纸色三角 */
  .prose-body :global(.tube-play) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: color-mix(in srgb, var(--paper) 22%, transparent);
    cursor: pointer;
    transition: background 0.3s var(--ease);
  }

  .prose-body :global(.tube-play::before) {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    background: var(--red);
    transition: scale 0.3s var(--ease);
  }

  .prose-body :global(.tube-play::after) {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    /* 三角形的视觉重心偏左，按几何中心摆会看着靠左，往右挪一点 */
    translate: -38% -50%;
    border-style: solid;
    border-width: 0.72rem 0 0.72rem 1.18rem;
    border-color: transparent transparent transparent var(--paper);
  }

  .prose-body :global(.tube-play:hover) {
    background: color-mix(in srgb, var(--paper) 6%, transparent);
  }

  .prose-body :global(.tube-play:hover::before) { scale: 1.08; }

  .prose-body :global(.dg-flow) {
    display: grid;
    justify-items: center;
    gap: 0;
  }

  .prose-body :global(.dg-flow > *) { width: 100%; max-width: 22rem; }

  .prose-body :global(.dg-arrow) {
    width: 1px;
    height: 1.5rem;
    background: var(--line-strong);
    justify-self: center;
    max-width: none;
  }

  .prose-body :global(.dg-arrow.long) { height: 2.25rem; }

  /* --- 一横排的小节点，中间带箭头 --- */
  .prose-body :global(.dg-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.4rem;
    width: 100%;
    max-width: none;
  }

  .prose-body :global(.dg-row .dg-node) { flex: 1 1 8rem; }

  .prose-body :global(.dg-sep) {
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--line-strong);
  }

  /* --- 分叉：两条并行的支线 --- */
  .prose-body :global(.dg-split) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 2vw, 1.5rem);
    width: 100%;
    max-width: none;
  }

  .prose-body :global(.dg-branch) {
    border: 1px solid var(--line);
    padding: 0.75rem;
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .prose-body :global(.dg-branch > .dg-label) {
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-stretch: var(--cond);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* --- 结局那一排 --- */
  .prose-body :global(.dg-ends) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.5rem, 1.5vw, 1rem);
    width: 100%;
    max-width: none;
  }

  .prose-body :global(.dg-ends .dg-node) { text-align: center; }

  /* --- 公式 --- */
  .prose-body :global(.dg-eq) {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-top: 0.45em;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--ink);
  }

  .prose-body :global(.dg-frac) {
    display: inline-grid;
    justify-items: center;
    line-height: 1.25;
  }

  .prose-body :global(.dg-frac > span:first-child) {
    border-bottom: 1px solid var(--ink);
    padding: 0 0.4em 0.1em;
  }

  .prose-body :global(.dg-frac > span:last-child) { padding: 0.1em 0.4em 0; }

  /* --- 规格表：三栏，逐行发丝线，跟卷宗表同一种读法 --- */
  .prose-body :global(.dg-tbl) {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) minmax(0, 1.6fr);
    column-gap: clamp(0.75rem, 2vw, 2rem);
  }

  .prose-body :global(.dg-tbl > *) {
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  /* 表头 */
  .prose-body :global(.dg-tbl > .dg-th) {
    padding-top: 0;
    padding-bottom: 0.4rem;
    border-bottom-color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--step--2);
    font-stretch: var(--cond);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  /* 第一列：阶段名 */
  .prose-body :global(.dg-tbl > .dg-stage) {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .prose-body :global(.dg-tbl > .dg-stage b) {
    display: block;
    color: var(--red);
    font-weight: 400;
  }

  @media (max-width: 760px) {
    .prose-body :global(.dg-tbl) { grid-template-columns: minmax(0, 1fr); }
    .prose-body :global(.dg-tbl > *) { border-bottom: 0; padding-block: 0.15rem; }
    .prose-body :global(.dg-tbl > .dg-th) { display: none; }
    .prose-body :global(.dg-tbl > .dg-stage) {
      margin-top: 1rem;
      padding-top: 0.6rem;
      border-top: 1px solid var(--line);
    }
  }

  /* --- 分层架构：左边层名，右边一排盒子 --- */
  .prose-body :global(.dg-layer) {
    display: grid;
    grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr);
    gap: clamp(0.75rem, 2vw, 1.75rem);
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }

