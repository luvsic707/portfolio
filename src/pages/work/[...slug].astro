---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HeroGallery from '../../components/HeroGallery.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);

  const sorted = projects.sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    return b.data.year.localeCompare(a.data.year);
  });

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, year, categories, summary, cover, coverAlt, meta, gallery, links, status, heroFit, surface, underlay, ground } = project.data;
const { Content, headings } = await render(project);

/* 章节索引：只取 ## 这一级，长案例才值得放 */
const sections = headings.filter((h) => h.depth === 2);

/* 开屏只认「00 封面」里的画廊图。
   cover 是列表页的缩略图，尺寸和构图都是按 4:3 卡片挑的，
   拿它顶一张满屏开屏并不合适 —— 没放画廊图就干脆不要开屏。 */
const slides = gallery ?? [];

/* 分享预览图：画廊里第一张图 */
const shareImage = cover?.src ?? gallery?.find((s) => s.image)?.image?.src;

/* ---- 卷宗编号 ----
   从 slug 首字母 + 序号推出来，不用另外维护字段。
   eden-of-east / 9 → RT-EOE-009，页眉和页脚都用它。 */
const refOf = (p: { id: string; data: { order?: number } }) =>
  `RT-${p.id.split('-').map((w) => w[0]).join('').toUpperCase().slice(0, 3)}-` +
  String(p.data.order ?? 0).padStart(3, '0');

const caseNo = String(project.data.order ?? 0).padStart(3, '0');
const ref = refOf(project);

/* 页眉右侧的日期区间：meta.date 有就用，没有就退回年份 */
const span = (meta as Record<string, string> | undefined)?.date ?? year;
---

<Base title={`${title} — Red Thread`} description={summary} image={shareImage} type="article">

  <!-- ==================== 开屏：全屏画廊 ==================== -->
  <article class:list={{ 'is-merge': surface === 'merge', 'is-white': ground === 'white' }}>
    {slides.length > 0 && <HeroGallery slides={slides} title={title} fit={heroFit} />}

    <!-- 开屏底下的一切装在这张「纸」上。开屏是钉住的，这张纸往上滑
         盖住它 —— 所以它必须是不透明的，也必须压在开屏上面。 -->
    <div class="sheet">

    <!-- ==================== 作品幽灵 ====================
         参考站（zyang.cargo.site/13-13）整页跑着一张极暗的石碑线稿，
         图直接压在上面 —— 所以那一页的底和图是同一件事，不是背景板
         加贴图。这里照做，但用这件作品自己的画。

         左右两半镜像，和参考站的对称碑面一样；浓度只有几个百分点，
         极慢地浮动。sticky + 负的下外边距：钉在视口里但不占布局，
         而且被这张纸自己的盒子裁住，不会糊到开屏上去。 -->
    {underlay && (
      <div class="underlay" aria-hidden="true">
        <Image src={underlay} alt="" widths={[900, 1400]} sizes="50vw" loading="lazy" />
        <Image src={underlay} alt="" widths={[900, 1400]} sizes="50vw" loading="lazy" class="flip" />
      </div>
    )}

    <!-- 观察窗的遥测块。
         首页右下角那一叠就是这个 —— 同样的字、同样的右对齐、同样的灰。
         之前这里是一条「REC · CAM 01」的闭路电视条，那是另一套虚构：
         首页在看显微镜，项目页在看监控，两个故事，所以谁都不鲜明。

         现在只有一套话：作品是放在观察窗下的标本，这一页就是它的读数。
         数都是真的 —— 张数是数出来的，节次跟着你读到哪儿变。 -->
    <pre class="telemetry" data-telemetry-case aria-hidden="true"></pre>

    <header class:list={['head', { 'has-shot': slides.length > 0 }]}>
      <div class="wrap">

        <!-- 页眉横栏：一本正经的档案抬头 -->
        <div class="rail rail-top">
          <a href="/work" class="rail-cell back">← RETURN</a>
          <span class="rail-cell">CASE FILE</span>
          <span class="rail-cell">{categories.join(' / ')}</span>
          {status && <span class="rail-cell is-status">STATUS: {status}</span>}
          <span class="rail-cell rail-end">{span}</span>
        </div>

        <!-- 编号行：编号 · 品名 · 序号 -->
        <div class="slug-line">
          <span class="ref">{ref}</span>
          <h1 class="title">{title}</h1>
          <span class="hash">#{caseNo}</span>
        </div>

        <p class="lede">{summary}</p>

        <!-- 检验表：横向分栏，不是竖着的键值对 -->
        <dl class="spec">
          <div class="spec-col">
            <dt>Année</dt>
            <dd>{year}</dd>
          </div>
          {meta && Object.entries(meta).map(([k, v]) => (
            <div class="spec-col">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>

        {links && links.length > 0 && (
          <ul class="extlinks">
            {links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label}<span class="arrow">&#8599;</span>
                  <span class="host">{new URL(l.href).host.replace(/^www\./, '')}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

      </div>
    </header>

    <!-- ==================== 章节索引 ==================== -->
    {sections.length > 2 && (
      <nav class="sections" aria-label="Sections">
        <div class="wrap">
          <ul class="sec-list" data-sections>
            {sections.map((h) => (
              <li>
                <a class="sec-link mono" href={`#${h.slug}`} data-sec={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}

    <!-- ==================== 正文 ==================== -->
    <div class="body">
      <div class="wrap">
        <!-- 页边竖排卷宗号，只在够宽的屏幕出现 -->
        <span class="folio" aria-hidden="true">{ref}</span>
        <div class="prose-body">
          <Content />
        </div>
      </div>
    </div>

    </div>
  </article>

  <!-- ==================== 上一件 / 下一件 ==================== -->
  <nav class="pager">
    <div class="wrap">
      <hr class="rule" />
      <div class="pager-row">
        {prev ? (
          <a class="pager-link is-prev" href={`/work/${prev.id}`}>
            <span class="pager-dir">← {refOf(prev)}</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : <span />}

        {next ? (
          <a class="pager-link is-next" href={`/work/${next.id}`}>
            <span class="pager-dir">{refOf(next)} →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </div>
    </div>
  </nav>

</Base>

<script>
  /* ---- 遥测块 ----
     和首页右下角那一叠是同一台仪器，只是标本换了。
     首页报的是血管数、灌流速度、清晰度；这里报的是这件作品的
     状态、张数、看到第几节、跑了多久 —— 全是这一页真实的数。

     UTIME 一秒一跳，和首页一样。写死的时间只是一张写着时间的图。 */
  {
    const tel = document.querySelector<HTMLElement>('[data-telemetry-case]');
    const art = document.querySelector<HTMLElement>('article');

    if (tel && art) {
      const pad = (s: string) => s.padEnd(10, ' ');
      const two = (n: number) => String(n).padStart(2, '0');

      const plates = document.querySelectorAll('.prose-body img, .prose-body video').length;
      const ref = art.querySelector('.ref')?.textContent?.trim() ?? '';
      const span = art.querySelector('.rail-end')?.textContent?.trim() ?? '';
      const status = art.querySelector('.is-status')?.textContent?.replace(/^STATUS:\s*/, '').trim();
      const total = document.querySelectorAll('[data-sec]').length;

      let sec = '';
      let focus = '';

      const draw = () => {
        const d = new Date();
        tel.textContent = [
          pad('SPECIMEN') + ref,
          pad('STATE') + (status || 'ARCHIVED'),
          sec && pad('SECTION') + sec + (total ? ` / ${total}` : ''),
          pad('PLATES') + plates,
          focus && pad('FOCUS') + focus,
          span && pad('SPAN') + span,
          pad('UTIME') + `${two(d.getHours())}:${two(d.getMinutes())}:${two(d.getSeconds())}`,
        ].filter(Boolean).join('\n');
      };

      addEventListener('rt:section', (e) => {
        sec = (e as CustomEvent<string>).detail;
        draw();
      });

      /* 鼠标停在哪张片子上，FOCUS 就报哪张 —— 和首页的准星是一个意思 */
      document
        .querySelectorAll<HTMLElement>('.prose-body img, .prose-body video')
        .forEach((el, i) => {
          el.addEventListener('pointerenter', () => {
            const w = el instanceof HTMLImageElement ? el.naturalWidth : (el as HTMLVideoElement).videoWidth;
            const h = el instanceof HTMLImageElement ? el.naturalHeight : (el as HTMLVideoElement).videoHeight;
            focus = `PL ${two(i + 1)}` + (w ? `  ${w}×${h}` : '');
            draw();
          });
          el.addEventListener('pointerleave', () => { focus = ''; draw(); });
        });

      draw();
      setInterval(draw, 1000);
    }
  }

  const body = document.querySelector<HTMLElement>('.prose-body');

  /* ---- 1. 把每个 ### 连同它底下的内容包成一个子小节 ----
     标题和说明进 .sub-head，图和列表进 .sub-main。样式见下面的 .sub。 */
  if (body) {
    let head: HTMLElement | null = null;
    let main: HTMLElement | null = null;

    for (const el of [...body.children] as HTMLElement[]) {
      if (el.tagName === 'H3') {
        const sub = document.createElement('section');
        sub.className = 'sub';
        head = document.createElement('div');
        head.className = 'sub-head';
        main = document.createElement('div');
        main.className = 'sub-main';
        sub.append(head, main);
        el.replaceWith(sub);
        head.append(el);
        continue;
      }
      if (!head || !main) continue;
      if (el.tagName === 'H2') { head = main = null; continue; }
      /* 纯文字说明跟着标题走，图和列表进右栏 */
      if (el.tagName === 'P' && !el.querySelector('img')) head.append(el);
      else main.append(el);
    }
  }

  /* ---- 1b. 还没有素材的小节 ----
     空标题后面跟一片空白，读起来像页面坏了。
     卷宗里这种情况本来就有写法 —— 封面缺图时写 NO PLATE ON FILE，
     这里沿用同一句式：与其假装没有这一节，不如写明在等素材。
     文件夹里一丢进图，import 脚本填上内容，这行自己就没了。 */
  body?.querySelectorAll<HTMLElement>('.sub').forEach((sub) => {
    const main = sub.querySelector<HTMLElement>('.sub-main');
    if (!main || main.children.length) return;
    const note = document.createElement('p');
    note.className = 'sub-pending mono';
    note.textContent = 'NO MATERIAL ON FILE';
    main.append(note);
  });

  /* ---- 1b2. 连着的出处清单并成一排 ----
     「参考文献」和「影视参考」各占一个小节，竖着摞就是两个标题、
     两条竖列表，七行短句拉出大半屏 —— 而它们其实是同一件事的两半。
     并排放，一眼读完，高度砍掉一半。 */
  if (body) {
    const subs = [...body.querySelectorAll<HTMLElement>(':scope > .sub')];
    let run: HTMLElement[] = [];

    const flush = () => {
      if (run.length > 1) {
        const pair = document.createElement('div');
        pair.className = 'source-pair';
        run[0].replaceWith(pair);
        pair.append(...run);

        /* 小节是按「h3 之后的一切」划的，所以跟在清单后面的图组
           （这里是三扇片子的窗）也被收进了同一个小节。清单并排之后
           那一栏只剩半幅宽，窗就被挤扁了。
           把清单以外的东西全部请出来，放到这一排的后面去，满宽。 */
        const after: Element[] = [];
        for (const sub of run) {
          const main = sub.querySelector('.sub-main');
          if (!main) continue;
          for (const kid of [...main.children]) {
            if (!kid.classList.contains('sources')) after.push(kid);
          }
        }
        pair.after(...after);
      }
      run = [];
    };

    for (const sub of subs) {
      if (sub.querySelector('.sources')) run.push(sub);
      else flush();
    }
    flush();
  }

  /* ---- 1c. 章节抬头收成一条横栏 ----
     原来是竖着摞的三块：节号、通栏线、说明段。说明只占左边三分之一，
     右边三分之二空着 —— 一节的开头就是一条又高又空的横带，把上一节的
     图和下一节的图硬生生切开。参考站 zyang.cargo.site/13-13 整页没有
     这种东西：标题一行、线一条、紧接着就是图。

     我们那几行说明是真写过的内容，不删。但它该是图注的身份，
     不是文章 —— 所以把节号和说明并进同一行，说明填满线上面的空档，
     整个抬头变成一条密实的横栏，压在通栏线上。

     这件事本来只在 merge 的项目上做，因为它是跟着那套一起想出来的。
     但它跟 merge 没有关系：开天窗的是抬头自己的排布，跟图怎么压在
     底面上是两回事，不开 merge 的项目一样在开。所以全站都这么排。 */
  for (const h2 of [...(body?.querySelectorAll<HTMLElement>(':scope > h2') ?? [])]) {
    const band = document.createElement('div');
    band.className = 'sheet-head';
    h2.replaceWith(band);
    band.append(h2);

    /* 紧跟着的说明段全部并进来，不是只收第一段。
       只收一段的话，写了三段的项目（借来的时光、印刷那两节）会把
       剩下两段留在线底下 —— 又变回一块横在图中间的文章。 */
    const note = document.createElement('div');
    note.className = 'sheet-note';
    while (
      band.nextElementSibling?.tagName === 'P' &&
      !band.nextElementSibling.querySelector('img')
    ) {
      note.append(band.nextElementSibling);
    }
    if (note.children.length) band.append(note);
  }

  /* ---- 1c-2. 图与图之间的正文收成一块，不是挂在左边的一条 ----
     节首的说明段有 .sheet-note 管着（上面 1c）。这里管的是另一种：
     图后面、表后面、还要接着说的那几段。

     它们原来一段接一段竖着摞，每段封在 56ch（约 437px）里，而同一节
     上下的表和图都是通栏 1310px —— 一条三分之一宽的细带子夹在两块
     通栏之间，右边三分之二是死白。卡牌那页 B 节四段连排，单这一处就
     空出三百像素高、八百多像素宽的一片。

     收成两栏：读法仍然是先下后右（CSS 多栏保证的顺序），但整块的外形
     跟上下的表和图一样是通栏。B 节那四段从 300px 高压到 130px。

     多段的时候每段加 break-inside: avoid，段不跨栏断开；栏宽 630px
     装得下整段，不会像 .sheet-note 那样被钉成细长条（那边是 46ch 的
     窄栏，所以那边不能加）。

     单独一段也收，但得够长。见下面 tallEnough。 */
  if (body) {
    const runnable = (el: Element | null | undefined) =>
      !!el &&
      (el.tagName === 'P' || el.tagName === 'BLOCKQUOTE') &&
      !el.querySelector('img') &&
      !el.querySelector('video');

    /* 单独一段要不要分栏，取决于它在栏宽下有几行 —— 不是它现在有几行。
       现在的行长是 56ch（437px），栏宽是 630px，同一段在栏里少三成行。

       四行起才分。三行分下来是「两行 + 一行」，右栏吊着半句话，正是
       要修的那种不平衡；两行分下来更糟，一句话左右各一行摊开一千三。

       所以先临时把它按栏宽量一次真高度，再决定 —— 拿字数猜行数得先猜
       字宽，量出来的是实数。量完把 style 抹掉，交给样式表。 */
    const probe = document.createElement('div');
    probe.className = 'run';
    body.append(probe);
    const colGap = parseFloat(getComputedStyle(probe).columnGap) || 0;
    const colW = (probe.clientWidth - colGap) / 2;
    probe.remove();

    const lineH = 22;
    const tallEnough = (p: Element) => {
      const style = (p as HTMLElement).style;
      const had = style.maxWidth;
      style.maxWidth = `${colW}px`;
      const lines = Math.round(p.getBoundingClientRect().height / lineH);
      style.maxWidth = had;
      return lines >= 4;
    };

    /* 走活的兄弟链，不走快照 —— 段落一旦被搬进 .run 就不再是 body 的
       子节点，照着快照走会把已经收进去的段再收一次，套出一层嵌套的
       .run，分栏就作废了。 */
    let el: Element | null = body.firstElementChild;
    while (el) {
      const isFirst = el === body.firstElementChild;
      if (!runnable(el) || isFirst) {
        el = el.nextElementSibling;
        continue;
      }
      const group: Element[] = [el];
      while (runnable(group[group.length - 1].nextElementSibling)) {
        group.push(group[group.length - 1].nextElementSibling as Element);
      }
      const next = group[group.length - 1].nextElementSibling;

      if (group.length > 1 || tallEnough(group[0])) {
        const run = document.createElement('div');
        /* 一段的时候要让它跨栏流下去（否则 break-inside: avoid 会把整段
           钉在第一栏，白排一次）；多段的时候相反，段不许断开。 */
        run.className = group.length === 1 ? 'run run-flow' : 'run';
        group[0].replaceWith(run);
        run.append(...group);
      }
      el = next;
    }
  }

  /* ---- 1d. 手排版面的落位 ----
     位置写在 md 的 data-plot 上，按图的顺序：
       「第几行 / 第几栏-第几栏 (+往下沉几 rem)」
     例：data-plot="1/1-11  2/6-13  2/2-7+4"

     为什么不直接在 md 里给每个 <p> 写 style —— 那得用原生 <img>，
     就绕开了 Astro 的图片优化（多档尺寸、WebP、宽高注入），
     而且 ./ 相对路径在构建后根本指不到东西。
     图还是写成 markdown 的 ![]()，位置从这里补上去。

     行必须写明：交叠要靠两张图都显式落位才成立，
     交给自动排的话第二张会被挤到下一行去。 */
  document.querySelectorAll<HTMLElement>('.prose-body .plot[data-plot]').forEach((el) => {
    const spec = (el.dataset.plot ?? '').trim().split(/\s+/);
    [...el.querySelectorAll<HTMLElement>(':scope > p')].forEach((p, i) => {
      /* 偏移可正可负：负的往上提，于是上下两行真的叠在一起。
         叠起来谁压谁看文档顺序 —— 写在后面的盖在上面。 */
      const m = /^(\d+)\/(\d+)-(\d+)(?:([+-][\d.]+))?$/.exec(spec[i] ?? '');
      if (!m) return;
      p.style.setProperty('--r', m[1]);
      p.style.setProperty('--c', `${m[2]} / ${m[3]}`);
      /* 偏移用 % 不用 rem。margin-top 的百分比是按包含块的**宽度**解析的
         （不是高度），这里的包含块就是这张图占的网格区 —— 于是偏移和栏宽
         用同一个尺子，版面整体缩放，换个视口宽度也不散。

         写成 rem 的时候不是这样：栏宽是 fr，跟着容器走；偏移是绝对长度，
         不跟。同一份 data-plot 在 800 宽下量出来是 1.05，到 1280 就成了
         0.95 —— 手排的位置只在调它的那个宽度上成立，别的宽度全是错的。

         没用 cqw 是因为那要给 .plot 加 container-type，而 container-type
         会建立层叠上下文，抠图的 multiply 会被关在里面 —— 上面 .underlay
         那段注释记的就是这个坑。百分比不需要容器，也就不碰这条线。 */
      if (m[4]) p.style.setProperty('--t', `${m[4]}%`);
    });
  });

  /* ---- 1e. 小窗：参考资料的出处 ----
     参考的书和电影不是作品，是「看过什么」。做成一排小窗摆在一起，
     每扇窗底下一行出处 —— 出处直接用 md 里图的 alt，
     所以写 md 的时候写一次就够了，不用另起一份说明。

     窗里放视频也走这条路：md 里换成 <video> 标签，这里自动接上
     静音循环自动播放，样式和静帧那几扇完全一样。 */
  document.querySelectorAll<HTMLElement>('.prose-body .windows').forEach((box) => {
    box.querySelectorAll<HTMLElement>(':scope > p').forEach((p) => {
      const media = p.querySelector<HTMLImageElement | HTMLVideoElement>('img, video');
      if (!media) return;

      if (media instanceof HTMLVideoElement) {
        /* 片段当画面用，不当播放器用：不出控件、不出声、自己循环。
           autoplay 必须配 muted，否则浏览器一律不给自动播。 */
        media.muted = true;
        media.loop = true;
        media.playsInline = true;
        media.removeAttribute('controls');

        /* 有人把动效关了就别自己动：停在 poster 上，那是片子的第一帧，
           窗里照样有画面。 */
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        /* autoplay 交给浏览器，别只靠 IntersectionObserver。
           只靠它的话，首次回调万一没赶上（标签页在后台、面板没显示），
           之后交叠状态一直没变就再也不会回调 —— 窗会一直空着。
           浏览器自己的 autoplay 没有这个洞，IO 只负责「看不见就停」。 */
        media.autoplay = true;

        /* 看不见就停：三段片子一直解码，风扇会转，手机上白烧电量，
           而人根本不在这一屏。 */
        new IntersectionObserver(([e]) => {
          if (e.isIntersecting) media.play().catch(() => {});
          else media.pause();
        }, { threshold: 0 }).observe(media);
      }

      const label = media instanceof HTMLImageElement
        ? media.alt
        : (media.getAttribute('aria-label') ?? '');
      if (!label || p.querySelector('.win-cap')) return;

      const cap = document.createElement('span');
      cap.className = 'win-cap';
      cap.textContent = label;
      p.append(cap);
    });
  });

  /* ---- 2. 过程图的横向滑动带 ----
     鼠标可以直接按住拖，触控板/触屏本来就能横滑。 */
  /* 按原始比例把图分栏：同一栏统一宽度、竖着摞满整条高度，
     所以栏内不会有窄图留下的空档，栏与栏之间也齐平。 */
  const layoutStrip = (strip: HTMLElement) => {
    const items: HTMLElement[] = (strip as any)._items
      ?? ((strip as any)._items = [...strip.querySelectorAll<HTMLElement>(':scope > p')]);
    if (!items.length) return;

    /* 先把图全倒回来，拆掉上一次分的栏 */
    strip.append(...items);
    strip.querySelectorAll('.strip-col').forEach((c) => c.remove());

    /* 图和视频都要认 —— 只找 img 的话，混排的视频会让整段崩掉 */
    const ratio = items.map((p) => {
      const el = p.querySelector<HTMLImageElement | HTMLVideoElement>('img, video');
      if (!el) return 1;
      const w = Number(el.getAttribute('width'))
        || (el as HTMLImageElement).naturalWidth
        || (el as HTMLVideoElement).videoWidth
        || 1;
      const h = Number(el.getAttribute('height'))
        || (el as HTMLImageElement).naturalHeight
        || (el as HTMLVideoElement).videoHeight
        || 1;
      return w / h;
    });

    const gap = parseFloat(getComputedStyle(strip).rowGap) || 6;

    /* 后台标签页里 innerHeight / clientWidth 会是 0，算出来整条塌成 0 高。
       兜底给个下限，等真正可见时再重排一次。 */
    const vh = innerHeight || document.documentElement.clientHeight || 800;
    const cw = strip.clientWidth || strip.parentElement?.clientWidth || 1200;

    const band = Math.max(320, Math.min(vh * 0.72, 780));
    const narrow = cw < 700;
    /* 目标栏宽：手机上约占七成屏宽，桌面上约占三成六。
       过程图也是作品，宁可少看几张也要看得清。 */
    const target = narrow
      ? cw * 0.72
      : Math.max(280, Math.min(cw * 0.36, 520));

    /* 每栏松紧不同才有节奏：宽的那栏只放一两张大图，紧的那栏摞三张小的。
       手机屏窄，节奏收敛一点，否则最紧的那栏会摞出四张指甲盖。 */
    const RHYTHM = narrow
      ? [1.3, 0.86, 1.0, 0.8]
      : [1.45, 0.78, 1.0, 0.62];

    const cols: { at: number[]; w: number }[] = [];
    let at: number[] = [];
    let inv = 0;

    items.forEach((_, i) => {
      at.push(i);
      inv += 1 / ratio[i];
      const w = (band - gap * (at.length - 1)) / inv;
      if (w <= target * RHYTHM[cols.length % RHYTHM.length]) {
        cols.push({ at, w });
        at = [];
        inv = 0;
      }
    });

    /* 收尾那一栏可能摞不满，宽度封顶，别让一张横图撑得离谱 */
    if (at.length) {
      cols.push({ at, w: Math.min((band - gap * (at.length - 1)) / inv, target * 1.4) });
    }

    for (const c of cols) {
      const col = document.createElement('div');
      col.className = 'strip-col';
      col.style.width = `${Math.round(c.w)}px`;
      c.at.forEach((i) => col.append(items[i]));
      strip.append(col);
    }
  };

  /* ---- 2a. 自己会走的滑动带 ----
     横滑带本来要人去拖才动。一条不动的带子和一张静止的长图没有区别，
     而且右边还有多少东西全靠边缘那道虚化去猜。

     所以让它自己极慢地走：20px/秒，一张图要走过去得二十多秒 ——
     慢到不像在播幻灯片，只是「这一条是活的，右边还有」。

     三条规矩：
     · 只在真的看得见的时候走（IntersectionObserver），后台不空转；
     · 人一碰（拖、滚轮、触屏、键盘）立刻让开，停五秒再接着走，
       而且从人停下的地方接，不跳回去；
     · 走到头掉头，不是倒回原点 —— 倒回去那一下会把人正在看的图抽走。

     位置自己拿一个浮点数记着。scrollLeft 在有些浏览器上会取整，
     每帧只走 0.33px 的话四舍五入回原值，整条就卡住不动了。 */
  const drift = (el: HTMLElement, speed = 20) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let pos = el.scrollLeft;
    let dir = 1;
    let last = 0;
    let hold = 0;          // 人碰过之后的让步时间，秒
    let seen = false;
    let raf = 0;

    /* 吸附要在自己走的时候关掉：proximity 会把每帧那 0.33px 拽回最近的
       吸附点，整条看着就是一动不动。人一碰立刻还回去。 */
    const snap = (on: boolean) => { el.style.scrollSnapType = on ? '' : 'none'; };

    /* 人自己动了：把浮点位置对回去，让开一会儿，并把吸附还回去 */
    const yield_ = () => { pos = el.scrollLeft; hold = 2.5; snap(true); };

    /* 关键是只认「冲着这一条来的」动作。

       原来 wheel 和 touchstart 一律算数，于是：你用滚轮往下翻页，指针
       正好扫过这条带子，每一下滚轮都算你在操作它，hold 一路顶到满 ——
       停下来还要干等好几秒它才动。手机上更糟，滑动带又高又宽，
       顺着页面往下划几乎一定是从某条带子上起手的。

       所以横向才算：滚轮看 deltaX 是不是压过 deltaY，触屏看这一划
       是横的还是竖的。竖着翻页跟这条带子没关系，它该继续走它的。 */
    el.addEventListener('pointerdown', yield_, { passive: true });
    el.addEventListener('keydown', yield_, { passive: true });

    el.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) yield_();
    }, { passive: true });

    let tx = 0;
    let ty = 0;
    el.addEventListener('touchstart', (e) => {
      tx = e.touches[0].clientX;
      ty = e.touches[0].clientY;
    }, { passive: true });
    el.addEventListener('touchmove', (e) => {
      const t0 = e.touches[0];
      if (Math.abs(t0.clientX - tx) > Math.abs(t0.clientY - ty)) yield_();
    }, { passive: true });

    const step = (t: number) => {
      raf = requestAnimationFrame(step);
      /* 切回前台时 dt 会是几十秒，封住上限，别让它瞬移到底 */
      const dt = last ? Math.min((t - last) / 1000, 0.05) : 0;
      last = t;
      if (!seen) return;
      if (hold > 0) { hold -= dt; pos = el.scrollLeft; return; }

      const max = el.scrollWidth - el.clientWidth;
      if (max <= 1) return;

      snap(false);
      pos += dir * speed * dt;
      if (pos >= max) { pos = max; dir = -1; hold = 3; }
      if (pos <= 0) { pos = 0; dir = 1; hold = 3; }
      el.scrollLeft = pos;
    };

    new IntersectionObserver(
      ([e]) => {
        seen = e.isIntersecting;
        if (seen) { last = 0; pos = el.scrollLeft; }
        else snap(true);
      },
      /* 不能用 threshold 判「看见了没有」—— 一条 680px 高的滑动带在
         768 高的窗口里，露出大半也只有 0.22，永远够不到门槛。

         门槛压到「露出一个像素就算」：入眼即走。原来还往里收了 12%，
         意思是带子要往上爬过视口高度的一成多才开始动 —— 从下面滚上来
         的时候，那一段正好是你第一眼看它的时候，结果它是死的。 */
      { threshold: 0 }
    ).observe(el);

    raf = requestAnimationFrame(step);
    addEventListener('pagehide', () => cancelAnimationFrame(raf));
  };

  document.querySelectorAll<HTMLElement>('.strip, .slider').forEach((strip) => {
    const n = strip.querySelectorAll('img').length;
    strip.tabIndex = 0;
    strip.setAttribute('role', 'group');
    strip.setAttribute('aria-label', `${n} images, scroll sideways`);

    const isSlider = strip.classList.contains('slider');
    if (!isSlider) layoutStrip(strip);

    let t = 0;
    const relayout = () => {
      clearTimeout(t);
      if (!isSlider) t = window.setTimeout(() => layoutStrip(strip), 150);
    };
    addEventListener('resize', relayout);
    /* 从后台切回前台时视口尺寸才真正确定，补排一次 */
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) relayout();
    });

    let down = false;
    let startX = 0;
    let startLeft = 0;
    let moved = false;

    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;    // 触屏交给系统自己滚
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = strip.scrollLeft;
      strip.classList.add('is-dragging');
    });

    strip.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      strip.scrollLeft = startLeft - dx;
    });

    const end = () => {
      down = false;
      strip.classList.remove('is-dragging');
    };
    strip.addEventListener('pointerup', end);
    strip.addEventListener('pointerleave', end);

    /* 拖完别把最后停下的那张图当成点击 */
    strip.addEventListener('click', (e) => { if (moved) e.preventDefault(); }, true);

    /* 滑到头了就把提示收掉 */
    const hint = () => {
      const more = strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 8;
      strip.classList.toggle('has-more', more);
    };
    strip.addEventListener('scroll', hint, { passive: true });
    new ResizeObserver(hint).observe(strip);
    hint();

    drift(strip);
  });

  /* ---- 2b. 片子入场 ----
     一张图进视野就淡进、放大到位。同一组里按顺序错开一点，
     一排四张是挨个落下去的，不是齐刷刷闪一下。

     错开只数到第六张就封顶：一条滑动带里有二十张，真按顺序排下去
     最后一张要等一秒多，人早滑过去了。

     只观察一次，进过就不再管 —— 来回滚不会反复闪。 */
  {
    const plates = document.querySelectorAll<HTMLElement>('.prose-body img, .prose-body video');

    if (plates.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      /* 同组之内的序号：拿它外面那层版式块当一组 */
      const seat = new Map<Element, number>();

      plates.forEach((el) => {
        el.classList.add('plate-in');
        const group = el.closest('.strip-col, .band, .pair, .lead, .solo, [class^="rows-"], [class^="grid-"], .reel, .cards')
          ?? el.parentElement!;
        const i = seat.get(group) ?? 0;
        seat.set(group, i + 1);
        el.style.transitionDelay = `${Math.min(i, 4) * 40}ms`;
      });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        },
        /* 提前发车：底边往外放 18%，图还在屏幕下面一截就开始淡入，
           等它真的进到你眼里，这一下基本已经演完了。

           原来是往里收 6% —— 图得先爬进屏幕 46px 才触发，再等最多
           350ms 的错开，再走 0.8 秒。加起来是「图早就在屏幕上了，
           还得等一秒多才看得见」，这就是那股迟滞感的来源。 */
        { rootMargin: '0px 0px 18% 0px', threshold: 0 }
      );

      plates.forEach((el) => io.observe(el));
    }
  }


  /* ---- 2c. 卡牌阵列和横向滑轨都会横滑，同样要告诉人右边还有 ---- */
  document.querySelectorAll<HTMLElement>('.prose-body .cards, .prose-body .reel').forEach((el) => {
    const hint = () => {
      el.classList.toggle('has-more', el.scrollLeft + el.clientWidth < el.scrollWidth - 8);
    };
    el.addEventListener('scroll', hint, { passive: true });
    new ResizeObserver(hint).observe(el);
    hint();

    /* 这两种块头比滑动带小，走慢一点才配得上 */
    drift(el, 14);
  });

  /* ---- 2b. 混排的视频：进视野才播，离开就停 ----
     不这么做的话一页几十个视频会同时解码，手机直接卡死。
     点一下切声音 —— 浏览器不允许带声自播，所以默认静音。 */
  /* ---- YouTube 外链片子 ----
     先只放一张缩略图和一个播放标记，点了才把播放器塞进来。
     一进页面就挂 iframe 的话，YouTube 的脚本、cookie 和几百 KB
     会跟着整页一起加载 —— 一节里放两个就够让页面卡一下。
     域名用 youtube-nocookie，点播放之前不写跟踪 cookie。 */
  document.querySelectorAll<HTMLElement>('[data-tube]').forEach((box) => {
    const id = box.dataset.tube;
    if (!id) return;
    const poster = document.createElement('img');
    poster.src = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
    poster.alt = '';
    poster.loading = 'lazy';
    poster.decoding = 'async';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'tube-play';
    btn.setAttribute('aria-label', box.dataset.tubeLabel || 'Play video');
    box.prepend(poster, btn);

    const open = () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`;
      f.title = box.dataset.tubeLabel || 'Video';
      f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture';
      f.allowFullscreen = true;
      box.textContent = '';
      box.append(f);
    };
    btn.addEventListener('click', open);
  });

  const inlineVideos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');

  if (inlineVideos.length) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const watch = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting && !reduced) v.play().catch(() => {});
          else v.pause();
        }
      },
      { rootMargin: '10% 0px' },
    );

    for (const v of inlineVideos) {
      watch.observe(v);
      v.addEventListener('click', () => {
        v.muted = !v.muted;
        /* 开了声音就把别的静音，不然满页在响 */
        if (!v.muted) {
          for (const o of inlineVideos) if (o !== v) o.muted = true;
          v.play().catch(() => {});
        }
      });
      v.style.cursor = 'pointer';
    }
  }

  /* ---- 3. 章节索引跟着滚动高亮 ----
     规则：哪一节占了屏幕最多，就算在看哪一节。任何时刻有且只有一片标签
     是抽出来的 —— 就像文件夹里永远只有一页翻开。

     试过两种更简单的写法，都不行：
     · IntersectionObserver 配 rootMargin，认「标题正落在视野中段」——
       标题一滚出那条带子就没人是当前节，整排标签一起熄灭，而一节往往
       有好几屏，于是大部分时间都是暗的。
     · 取最后一个滚过标签条的标题 —— 永远有一片亮着，但下一节的标题
       都露出大半屏了，只要它还没顶到条上，标签就还停在上一节。
       屏幕上明明写着 D，标签却说 C。 */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-sec]')];

  if (links.length) {
    const heads = links
      .map((a) => ({ a, el: document.getElementById(a.dataset.sec!) }))
      .filter((h): h is { a: HTMLAnchorElement; el: HTMLElement } => !!h.el);

    const list = document.querySelector<HTMLElement>('[data-sections]');
    const bar = document.querySelector<HTMLElement>('.sections');
    let cur: (typeof heads)[number] | null = null;
    let queued = false;

    /* ---- 标签条钉住的时候，页头收掉自己的底线 ----
       页头一滚起来会浮出纸色加一条底线（见 Nav.astro）。标签条钉在它
       底下时，两条平行的灰线夹出一条 35px 的窄带，读着像一行空表头。

       而标签条是按「夹子的硬纸边」做的（见下面 .sections 的注释）：
       当前那片标签要压住夹子的边线，让标签和正文连成同一张纸。顶上
       横着一条别人画的线，夹子这个意思就不成立了。

       页头是 paper 94%，标签条是 paper-sunk，明度本来就差一档 ——
       交界处不用线也分得开。

       钉住了没有类名可问，就拿它现在的 top 和 CSS 里写的停靠位置比：
       贴上了就是钉住了。判断挂在 mark() 里跟着同一个 rAF 走，不另外
       加滚动监听。改了才广播，页头自己决定怎么响应 —— 跟 rt:section
       一样，两处逻辑不互相伸手。 */
    let tabbed: boolean | null = null;

    const pin = () => {
      if (!bar) return;
      const stop = parseFloat(getComputedStyle(bar).top) || 0;
      const now = bar.getBoundingClientRect().top <= stop + 1;
      if (now === tabbed) return;
      tabbed = now;
      dispatchEvent(new CustomEvent('rt:tabbed', { detail: now }));
    };

    const mark = () => {
      queued = false;
      pin();
      if (!heads.length) return;
      /* 每一节的地盘是「自己的标题到下一节的标题」。
         把它和标签条以下的可视区域求交集，谁的交集长谁就是当前节。 */
      const top = bar?.getBoundingClientRect().bottom ?? 0;
      const tops = heads.map((h) => h.el.getBoundingClientRect().top);

      let now = heads[0];
      let best = -Infinity;
      for (let i = 0; i < heads.length; i++) {
        const end = i + 1 < heads.length ? tops[i + 1] : Infinity;
        const seen = Math.min(end, innerHeight) - Math.max(tops[i], top);
        if (seen > best) {
          best = seen;
          now = heads[i];
        }
      }
      if (now === cur) return;
      cur = now;

      /* 监控条要知道现在在第几节。广播一下，别让两处逻辑互相伸手。 */
      const label = now.a.textContent?.trim().split(/\s*[—–-]\s*/)[0] ?? '';
      dispatchEvent(new CustomEvent('rt:section', { detail: label }));
      for (const h of heads) {
        const on = h === now;
        h.a.classList.toggle('is-on', on);
        /* 屏幕阅读器也要知道翻开的是哪一页，不能只靠颜色和纸张 */
        if (on) h.a.setAttribute('aria-current', 'true');
        else h.a.removeAttribute('aria-current');
      }

      /* 只横向挪索引条本身。用 scrollIntoView 会连整页一起滚，把人拽走。 */
      if (list && list.scrollWidth > list.clientWidth) {
        const l = now.a.offsetLeft;
        const r = l + now.a.offsetWidth;
        if (l < list.scrollLeft || r > list.scrollLeft + list.clientWidth) {
          list.scrollTo({ left: l - 12, behavior: 'smooth' });
        }
      }
    };

    /* 两头的渐隐：还能往那个方向滑，就挂上对应的类 */
    const edges = () => {
      if (!list) return;
      const max = list.scrollWidth - list.clientWidth;
      list.classList.toggle('more-l', list.scrollLeft > 2);
      list.classList.toggle('more-r', list.scrollLeft < max - 2);
    };

    const ping = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(mark);
    };

    addEventListener('scroll', ping, { passive: true });
    addEventListener('resize', ping);
    list?.addEventListener('scroll', edges, { passive: true });
    addEventListener('resize', edges);
    mark();
    edges();
  }
</script>

<style>
  /* ==================== 遥测块 ====================
     和首页 .telemetry 是同一套值：等宽、10px、行高 1.7、字距 0.04em、
     --ink-faint、右下角、不吃鼠标。一眼要看得出是同一台仪器。

     首页是 absolute（开屏就一屏高）；项目页是长页，所以钉在视口上，
     一路跟着走 —— 观察窗不会因为标本长就挪开。 */
  .telemetry {
    position: fixed;
    right: var(--gutter);
    bottom: 1.6rem;
    z-index: 6;
    margin: 0;
    font-family: var(--font-mono);
