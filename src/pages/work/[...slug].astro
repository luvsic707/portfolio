---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HeroGallery from '../../components/HeroGallery.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);

  const sorted = projects.sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    return b.data.year.localeCompare(a.data.year);
  });

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, year, categories, summary, cover, coverAlt, meta, gallery } = project.data;
const { Content, headings } = await render(project);

/* 章节索引：只取 ## 这一级，长案例才值得放 */
const sections = headings.filter((h) => h.depth === 2);

/* 画廊优先；只给了单张 cover 时把它当成只有一格的画廊 */
const slides =
  gallery && gallery.length > 0
    ? gallery
    : cover
      ? [{ image: cover, alt: coverAlt }]
      : [];

/* 分享预览图：画廊里第一张图 */
const shareImage = cover?.src ?? gallery?.find((s) => s.image)?.image?.src;
---

<Base title={`${title} — Red Thread`} description={summary} image={shareImage} type="article">

  <!-- ==================== 开屏：全屏画廊 ==================== -->
  <article>
    {slides.length > 0 && <HeroGallery slides={slides} title={title} />}

    <header class:list={['head', { 'has-shot': slides.length > 0 }]}>
      <div class="wrap">

        <a href="/work" class="back mono">← WORK</a>

        <h1 class="title">{title}</h1>

        <p class="lede prose">{summary}</p>

        <!-- 等宽元信息块 —— 终端感的来源 -->
        <dl class="meta">
          <div class="meta-row">
            <dt class="mono">year</dt>
            <dd class="mono">{year}</dd>
          </div>
          <div class="meta-row">
            <dt class="mono">category</dt>
            <dd class="mono">{categories.join(' · ')}</dd>
          </div>
          {meta && Object.entries(meta).map(([k, v]) => (
            <div class="meta-row">
              <dt class="mono">{k}</dt>
              <dd class="mono">{v}</dd>
            </div>
          ))}
        </dl>

      </div>
    </header>

    <!-- ==================== 章节索引 ==================== -->
    {sections.length > 2 && (
      <nav class="sections" aria-label="Sections">
        <div class="wrap">
          <ul class="sec-list" data-sections>
            {sections.map((h) => (
              <li>
                <a class="sec-link mono" href={`#${h.slug}`} data-sec={h.slug}>{h.text}</a>
              </li>
            ))}
          </ul>
        </div>
      </nav>
    )}

    <!-- ==================== 正文 ==================== -->
    <div class="body">
      <div class="wrap">
        <div class="prose-body">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- ==================== 上一件 / 下一件 ==================== -->
  <nav class="pager">
    <div class="wrap">
      <hr class="rule" />
      <div class="pager-row">
        {prev ? (
          <a class="pager-link is-prev" href={`/work/${prev.id}`}>
            <span class="mono pager-dir">← Previous</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : <span />}

        {next ? (
          <a class="pager-link is-next" href={`/work/${next.id}`}>
            <span class="mono pager-dir">Next →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </div>
    </div>
  </nav>

</Base>

<script>
  const body = document.querySelector<HTMLElement>('.prose-body');

  /* ---- 1. 子小节改成两栏：标题和说明在左，图在右 ----
     ### 底下往往只有三四张小图，标题独占一行太浪费高度。 */
  if (body) {
    let head: HTMLElement | null = null;
    let main: HTMLElement | null = null;

    for (const el of [...body.children] as HTMLElement[]) {
      if (el.tagName === 'H3') {
        const sub = document.createElement('section');
        sub.className = 'sub';
        head = document.createElement('div');
        head.className = 'sub-head';
        main = document.createElement('div');
        main.className = 'sub-main';
        sub.append(head, main);
        el.replaceWith(sub);
        head.append(el);
        continue;
      }
      if (!head || !main) continue;
      if (el.tagName === 'H2') { head = main = null; continue; }
      /* 纯文字说明跟着标题走，图和列表进右栏 */
      if (el.tagName === 'P' && !el.querySelector('img')) head.append(el);
      else main.append(el);
    }
  }

  /* ---- 2. 过程图的横向滑动带 ----
     鼠标可以直接按住拖，触控板/触屏本来就能横滑。 */
  document.querySelectorAll<HTMLElement>('.strip').forEach((strip) => {
    const n = strip.querySelectorAll('img').length;
    strip.tabIndex = 0;
    strip.setAttribute('role', 'group');
    strip.setAttribute('aria-label', `${n} images, scroll sideways`);

    let down = false;
    let startX = 0;
    let startLeft = 0;
    let moved = false;

    strip.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;    // 触屏交给系统自己滚
      down = true;
      moved = false;
      startX = e.clientX;
      startLeft = strip.scrollLeft;
      strip.classList.add('is-dragging');
    });

    strip.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      strip.scrollLeft = startLeft - dx;
    });

    const end = () => {
      down = false;
      strip.classList.remove('is-dragging');
    };
    strip.addEventListener('pointerup', end);
    strip.addEventListener('pointerleave', end);

    /* 拖完别把最后停下的那张图当成点击 */
    strip.addEventListener('click', (e) => { if (moved) e.preventDefault(); }, true);

    /* 滑到头了就把提示收掉 */
    const hint = () => {
      const more = strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 8;
      strip.classList.toggle('has-more', more);
    };
    strip.addEventListener('scroll', hint, { passive: true });
    new ResizeObserver(hint).observe(strip);
    hint();
  });

  /* ---- 3. 章节索引跟着滚动高亮 ---- */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-sec]')];

  if (links.length) {
    const byId = new Map(links.map((a) => [a.dataset.sec!, a]));
    const seen = new Set<string>();

    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) seen.add(e.target.id);
          else seen.delete(e.target.id);
        }
        /* 视野里最靠上的那节算当前节 */
        const current = links.find((a) => seen.has(a.dataset.sec!));
        links.forEach((a) => a.classList.toggle('is-on', a === current));
        current?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );

    for (const id of byId.keys()) {
      const h = document.getElementById(id);
      if (h) spy.observe(h);
    }
  }
</script>

<style>
  /* ==================== 标题区 ==================== */

  .head {
    padding-top: clamp(6.5rem, 13vw, 10rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  /* 有开屏图时标题区不用再留那么高的顶部空白 */
  .head.has-shot {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .back {
    display: inline-block;
    color: var(--ink-faint);
    letter-spacing: 0.16em;
    transition: color 0.2s var(--ease);
  }

  .back:hover { color: var(--red); }

  .title {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.032em;
    max-width: 20ch;
    text-wrap: balance;
  }

  .lede {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  /* --- 元信息 --- */

  .meta {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--line);
    max-width: 46rem;
  }

  .meta-row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--line);
  }

  .meta-row dt {
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }

  .meta-row dd {
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (max-width: 560px) {
    .meta-row { grid-template-columns: 1fr; gap: 0.15rem; }
  }

  /* ==================== 封面 ==================== */

  .cover { margin-block: clamp(1.5rem, 4vw, 3rem); }

  .cover img {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  /* ==================== 章节索引 ==================== */

  .sections {
    position: sticky;
    top: var(--nav-h, 3.4rem);
    z-index: 5;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--line);
  }

  .sec-list {
    display: flex;
    gap: 0.35rem;
    padding-block: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .sec-list::-webkit-scrollbar { display: none; }

  .sec-link {
    display: block;
    white-space: nowrap;
    padding: 0.35em 0.7em;
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    border: 1px solid transparent;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .sec-link:hover { color: var(--ink); }

  .sec-link.is-on {
    color: var(--red);
    border-color: var(--red);
  }

  /* ==================== 正文 ==================== */

  .body { padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 9vw, 7rem); }

  /* 锚点跳转时别被吸顶的导航和索引条挡住 */
  .prose-body :global(h2) { scroll-margin-top: calc(var(--nav-h, 3.4rem) + 3.5rem); }

  /* Markdown 渲染出来的内容 —— 长文用衬线，小标题用等宽。
     作品集是看图的，正文压到一栏窄字，让位给图。 */
  .prose-body :global(p) {
    font-family: var(--font-prose);
    font-size: var(--step-0);
    line-height: 1.7;
    max-width: 56ch;
    color: var(--ink-soft);
  }

  /* 开篇第一段仍然当引言，稍微重一点 */
  .prose-body > :global(p:first-child) {
    font-size: var(--step-1);
    line-height: 1.66;
    color: var(--ink);
    max-width: 62ch;
  }

  .prose-body :global(strong) { color: var(--ink); }

  .prose-body :global(p + p) { margin-top: 1.1em; }

  /* 章节标题：# A / ## MATERIAL EXPERIMENT 这类 */
  .prose-body :global(h2) {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .prose-body :global(h2)::before {
    content: '▶ ';
    color: var(--red);
  }

  .prose-body :global(h2 + p) { margin-top: 1.4rem; }

  .prose-body :global(h3) {
    margin-top: 2.2rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .prose-body :global(h3 + p) { margin-top: 0.7rem; }

  .prose-body :global(img) {
    width: 100%;
    height: auto;
    margin-block: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  /* ---- 正文里的排版工具 ----
     在 md 里直接写 <div class="grid-2"> 就能用，详见 README。 */

  /* 用多栏而不是 grid：图按上传时的原始比例呈现，高度参差也不会留空档。
     2:1 就是 2:1，竖图就是竖图，一律不裁。 */
  .prose-body :global(.grid-2),
  .prose-body :global(.grid-3),
  .prose-body :global(.grid-4) {
    column-gap: clamp(0.6rem, 1.6vw, 1.1rem);
    margin-block: clamp(1.75rem, 4vw, 3rem);
    /* 网格整体比正文宽 —— 正文是给人读的，图是给人看的 */
    width: min(100%, 1180px);
  }

  .prose-body :global(.grid-2) { column-count: 2; }
  .prose-body :global(.grid-3) { column-count: 3; }
  .prose-body :global(.grid-4) { column-count: 4; }

  /* 每张图是一个栏内块，不许被拆到两栏去 */
  .prose-body :global([class^='grid-'] p) {
    margin: 0 0 clamp(0.6rem, 1.6vw, 1.1rem);
    position: relative;
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .prose-body :global([class^='grid-'] img) {
    margin: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  /* 网格里只剩一张图时，别让它缩在一栏里 */
  .prose-body :global([class^='grid-']:has(> p:only-child)) {
    column-count: 1;
    width: min(100%, 560px);
  }

  /* 悬停微微放大并浮起，方便看清小图 */
  @media (hover: hover) and (pointer: fine) {
    .prose-body :global([class^='grid-'] p:hover) {
      transform: scale(1.045);
      z-index: 2;
      box-shadow: 0 8px 26px rgba(23, 22, 20, 0.16);
    }
  }

  @media (max-width: 900px) {
    .prose-body :global(.grid-4) { column-count: 3; }
  }

  @media (max-width: 640px) {
    .prose-body :global(.grid-3),
    .prose-body :global(.grid-4) { column-count: 2; }
  }

  /* 通栏大图：冲破正文宽度铺满视口，用来放主视觉 */
  .prose-body :global(.full) {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .prose-body :global(.full p) { margin: 0; }

  .prose-body :global(.full img) {
    margin: 0;
    border-inline: 0;
  }

  /* ---- 成品：大而直接 ----
     冲破正文宽度，两列大图，高度错落用多栏自然填满。 */
  .prose-body :global(.showcase) {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(2.5rem, 6vw, 4.5rem);
    padding-inline: clamp(0.75rem, 3vw, 3rem);
    column-count: 2;
    column-gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .prose-body :global(.showcase p) {
    margin: 0 0 clamp(0.75rem, 2vw, 1.5rem);
    break-inside: avoid;
  }

  .prose-body :global(.showcase img) {
    margin: 0;
    display: block;
    width: 100%;
    height: auto;
  }

  /* 只有一张成品时不分栏，居中放到最大 */
  .prose-body :global(.showcase:has(> p:only-child)) {
    column-count: 1;
    max-width: 1100px;
    margin-inline: auto;
  }

  @media (max-width: 760px) {
    .prose-body :global(.showcase) { column-count: 1; }
  }

  /* ---- 过程：横向滑动带 ----
     图小、高度错落，纵向只占一条，看多少全凭手往旁边推。 */
  .prose-body :global(.strip) {
    position: relative;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(1.75rem, 4vw, 3rem);
    padding: 0.5rem clamp(0.75rem, 3vw, 3rem) 1.25rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: max-content;
    align-items: center;
    gap: clamp(0.5rem, 1.4vw, 1rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    /* 吸附时把左右内边距算进去，第一张才不会被顶到贴边 */
    scroll-padding-inline: clamp(0.75rem, 3vw, 3rem);
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    cursor: grab;
  }

  .prose-body :global(.strip.is-dragging) { cursor: grabbing; scroll-snap-type: none; }

  .prose-body :global(.strip p) {
    margin: 0;
    scroll-snap-align: start;
    transition: transform 0.35s var(--ease);
  }

  /* 高度按 4 张一轮错落，排面才灵动，不是一条整齐的胶片 */
  .prose-body :global(.strip img) {
    margin: 0;
    display: block;
    height: clamp(150px, 22svh, 250px);
    width: auto;
    max-width: none;
  }

  .prose-body :global(.strip p:nth-child(4n + 2) img) { height: clamp(190px, 29svh, 330px); }
  .prose-body :global(.strip p:nth-child(4n + 3) img) { height: clamp(130px, 19svh, 215px); }

  /* 右边还有内容时给一道渐隐，暗示可以继续推 */
  .prose-body :global(.strip)::after {
    content: '';
    position: sticky;
    right: 0;
    justify-self: end;
    width: clamp(2rem, 6vw, 5rem);
    height: 100%;
    background: linear-gradient(to right, transparent, var(--paper));
    opacity: 0;
    transition: opacity 0.3s var(--ease);
    pointer-events: none;
  }

  .prose-body :global(.strip.has-more)::after { opacity: 1; }

  @media (hover: hover) and (pointer: fine) {
    .prose-body :global(.strip p:hover) { transform: translateY(-4px); }
  }

  /* 滑动带在子小节里就老实待在右栏，不再通栏 */
  .prose-body :global(.sub-main .strip) {
    width: 100%;
    margin-inline: 0;
    padding-inline: 0;
  }

  /* ---- 子小节：标题在左，图在右 ---- */
  .prose-body :global(.sub) {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    margin-block: clamp(1.75rem, 4vw, 2.75rem);
    width: min(100%, 1180px);
  }

  /* 图多的时候标题跟着滚一段，一直知道在看哪一类 */
  .prose-body :global(.sub-head) {
    position: sticky;
    top: calc(var(--nav-h, 3.4rem) + 4rem);
  }

  .prose-body :global(.sub h3) { margin-top: 0; }

  .prose-body :global(.sub-head p) {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .prose-body :global(.sub-main > :first-child) { margin-top: 0; }

  .prose-body :global(.sub-main [class^='grid-']),
  .prose-body :global(.sub-main .clamp) { width: 100%; }

  @media (max-width: 860px) {
    .prose-body :global(.sub) { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .prose-body :global(.sub-head) { position: static; }
  }

  /* 正文里的视频 */
  .prose-body :global(.videos) {
    width: min(100%, 1180px);
    margin-block: clamp(1.75rem, 4vw, 3rem);
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .prose-body :global(.videos video) {
    width: 100%;
    height: auto;
    display: block;
    background: var(--ink);
    border: 1px solid var(--line);
  }

  /* 图注 */
  .prose-body :global(figure) {
    margin-block: clamp(1.75rem, 4vw, 3rem);
  }

  .prose-body :global(figure img) { margin-block: 0; }

  .prose-body :global(figcaption) {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  .prose-body :global(figcaption)::before {
    content: '— ';
    color: var(--red);
  }

  .prose-body :global(em) { font-style: italic; }
  .prose-body :global(strong) { font-weight: 600; }

  .prose-body :global(a) {
    border-bottom: 1px solid var(--red);
    transition: background 0.2s var(--ease);
  }
  .prose-body :global(a:hover) { background: var(--red-wash); }

  .prose-body :global(blockquote) {
    margin-block: 2rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--red);
    font-family: var(--font-prose);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .prose-body :global(ul) {
    margin-top: 1.1em;
    max-width: var(--measure);
  }

  .prose-body :global(li) {
    position: relative;
    padding-left: 1.4em;
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.7;
  }

