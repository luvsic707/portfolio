---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import HeroGallery from '../../components/HeroGallery.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);

  const sorted = projects.sort((a, b) => {
    const ao = a.data.order ?? 999;
    const bo = b.data.order ?? 999;
    if (ao !== bo) return ao - bo;
    return b.data.year.localeCompare(a.data.year);
  });

  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { title, year, categories, summary, cover, coverAlt, meta, gallery } = project.data;
const { Content } = await render(project);

/* 画廊优先；只给了单张 cover 时把它当成只有一格的画廊 */
const slides =
  gallery && gallery.length > 0
    ? gallery
    : cover
      ? [{ image: cover, alt: coverAlt }]
      : [];

/* 分享预览图：画廊里第一张图 */
const shareImage = cover?.src ?? gallery?.find((s) => s.image)?.image?.src;
---

<Base title={`${title} — Red Thread`} description={summary} image={shareImage} type="article">

  <!-- ==================== 开屏：全屏画廊 ==================== -->
  <article>
    {slides.length > 0 && <HeroGallery slides={slides} title={title} />}

    <header class:list={['head', { 'has-shot': slides.length > 0 }]}>
      <div class="wrap">

        <a href="/work" class="back mono">← WORK</a>

        <h1 class="title">{title}</h1>

        <p class="lede prose">{summary}</p>

        <!-- 等宽元信息块 —— 终端感的来源 -->
        <dl class="meta">
          <div class="meta-row">
            <dt class="mono">year</dt>
            <dd class="mono">{year}</dd>
          </div>
          <div class="meta-row">
            <dt class="mono">category</dt>
            <dd class="mono">{categories.join(' · ')}</dd>
          </div>
          {meta && Object.entries(meta).map(([k, v]) => (
            <div class="meta-row">
              <dt class="mono">{k}</dt>
              <dd class="mono">{v}</dd>
            </div>
          ))}
        </dl>

      </div>
    </header>

    <!-- ==================== 正文 ==================== -->
    <div class="body">
      <div class="wrap">
        <div class="prose-body">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <!-- ==================== 上一件 / 下一件 ==================== -->
  <nav class="pager">
    <div class="wrap">
      <hr class="rule" />
      <div class="pager-row">
        {prev ? (
          <a class="pager-link is-prev" href={`/work/${prev.id}`}>
            <span class="mono pager-dir">← Previous</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : <span />}

        {next ? (
          <a class="pager-link is-next" href={`/work/${next.id}`}>
            <span class="mono pager-dir">Next →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : <span />}
      </div>
    </div>
  </nav>

</Base>

<style>
  /* ==================== 标题区 ==================== */

  .head {
    padding-top: clamp(6.5rem, 13vw, 10rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  /* 有开屏图时标题区不用再留那么高的顶部空白 */
  .head.has-shot {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  .back {
    display: inline-block;
    color: var(--ink-faint);
    letter-spacing: 0.16em;
    transition: color 0.2s var(--ease);
  }

  .back:hover { color: var(--red); }

  .title {
    margin-top: 1.2rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.032em;
    max-width: 20ch;
    text-wrap: balance;
  }

  .lede {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }

  /* --- 元信息 --- */

  .meta {
    margin-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--line);
    max-width: 46rem;
  }

  .meta-row {
    display: grid;
    grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--line);
  }

  .meta-row dt {
    color: var(--ink-faint);
    letter-spacing: 0.1em;
  }

  .meta-row dd {
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (max-width: 560px) {
    .meta-row { grid-template-columns: 1fr; gap: 0.15rem; }
  }

  /* ==================== 封面 ==================== */

  .cover { margin-block: clamp(1.5rem, 4vw, 3rem); }

  .cover img {
    width: 100%;
    border: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  /* ==================== 正文 ==================== */

  .body { padding-block: clamp(2rem, 5vw, 4rem) clamp(4rem, 9vw, 7rem); }

  /* Markdown 渲染出来的内容 —— 长文用衬线，小标题用等宽 */
  .prose-body :global(p) {
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.74;
    max-width: var(--measure);
  }

  .prose-body :global(p + p) { margin-top: 1.1em; }

  /* 章节标题：# A / ## MATERIAL EXPERIMENT 这类 */
  .prose-body :global(h2) {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .prose-body :global(h2)::before {
    content: '▶ ';
    color: var(--red);
  }

  .prose-body :global(h2 + p) { margin-top: 1.4rem; }

  .prose-body :global(h3) {
    margin-top: 2.2rem;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .prose-body :global(h3 + p) { margin-top: 0.7rem; }

  .prose-body :global(img) {
    width: 100%;
    height: auto;
    margin-block: clamp(1.75rem, 4vw, 3rem);
    border: 1px solid var(--line);
    background: var(--paper-sunk);
  }

  /* ---- 正文里的排版工具 ----
     在 md 里直接写 <div class="grid-2"> 就能用，详见 README。 */

  .prose-body :global(.grid-2),
  .prose-body :global(.grid-3),
  .prose-body :global(.grid-4) {
    display: grid;
    gap: clamp(0.6rem, 1.6vw, 1.1rem);
    margin-block: clamp(1.75rem, 4vw, 3rem);
    /* 网格整体比正文宽 —— 正文是给人读的，图是给人看的 */
    width: min(100%, 1180px);
  }

  .prose-body :global(.grid-2) { grid-template-columns: repeat(2, 1fr); }
  .prose-body :global(.grid-3) { grid-template-columns: repeat(3, 1fr); }
  .prose-body :global(.grid-4) { grid-template-columns: repeat(4, 1fr); }

  /* 网格里的每张图各占一格：段落是格子，取消自身外边距，间距交给 gap */
  .prose-body :global([class^='grid-'] p) {
    margin: 0;
    position: relative;
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }

  .prose-body :global([class^='grid-'] img) {
    margin: 0;
    aspect-ratio: 1;
    object-fit: cover;
    height: 100%;
  }

  /* 悬停微微放大并浮起，方便看清小图 */
  @media (hover: hover) and (pointer: fine) {
    .prose-body :global([class^='grid-'] p:hover) {
      transform: scale(1.045);
      z-index: 2;
      box-shadow: 0 8px 26px rgba(23, 22, 20, 0.16);
    }
  }

  @media (max-width: 900px) {
    .prose-body :global(.grid-4) { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 640px) {
    .prose-body :global(.grid-3),
    .prose-body :global(.grid-4) { grid-template-columns: repeat(2, 1fr); }
  }

  /* 通栏大图：冲破正文宽度铺满视口，用来放主视觉 */
  .prose-body :global(.full) {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .prose-body :global(.full p) { margin: 0; }

  .prose-body :global(.full img) {
    margin: 0;
    border-inline: 0;
  }

  /* 正文里的视频 */
  .prose-body :global(.videos) {
    width: min(100%, 1180px);
    margin-block: clamp(1.75rem, 4vw, 3rem);
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .prose-body :global(.videos video) {
    width: 100%;
    height: auto;
    display: block;
    background: var(--ink);
    border: 1px solid var(--line);
  }

  /* 图注 */
  .prose-body :global(figure) {
    margin-block: clamp(1.75rem, 4vw, 3rem);
  }

  .prose-body :global(figure img) { margin-block: 0; }

  .prose-body :global(figcaption) {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  .prose-body :global(figcaption)::before {
    content: '— ';
    color: var(--red);
  }

  .prose-body :global(em) { font-style: italic; }
  .prose-body :global(strong) { font-weight: 600; }

  .prose-body :global(a) {
    border-bottom: 1px solid var(--red);
    transition: background 0.2s var(--ease);
  }
  .prose-body :global(a:hover) { background: var(--red-wash); }

  .prose-body :global(blockquote) {
    margin-block: 2rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--red);
    font-family: var(--font-prose);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .prose-body :global(ul) {
    margin-top: 1.1em;
    max-width: var(--measure);
  }

  .prose-body :global(li) {
    position: relative;
    padding-left: 1.4em;
    font-family: var(--font-prose);
    font-size: var(--step-1);
    line-height: 1.7;
  }

  .prose-body :global(li + li) { margin-top: 0.4em; }

  .prose-body :global(li)::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--red);
  }

  .prose-body :global(hr) {
    margin-block: clamp(2.5rem, 6vw, 4rem);
    height: 1px;
    background: var(--line);
    border: 0;
  }

  /* ==================== 翻页 ==================== */

  .pager { padding-bottom: 1rem; }

  .pager-row {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.5rem;
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 22ch;
  }

  .is-next { text-align: right; }

  .pager-dir {
    color: var(--ink-faint);
    letter-spacing: 0.12em;
    text-transform: none;
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    transition: color 0.2s var(--ease);
  }

  .pager-link:hover .pager-title { color: var(--red); }
</style>
