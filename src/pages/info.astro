---
import Base from '../layouts/Base.astro';

/* 这几块直接改文字就行 */
const capabilities = [
  'Brand Design',
  'Illustration',
  'Tattoo',
  'Game Design',
  'Graphic & Visual Communication',
  'AR / VR',
  'Animation',
];

const tools = ['Procreate', 'Photoshop', 'Illustrator', 'Unity', 'Blender', 'Figma', 'After Effects'];

/* 学历和经历混在一条时间线上，按开始年份倒序。
   学位名和学校分两行 —— 挤在一行里读起来像一串逗号，
   分开之后眼睛先扫到学位，再落到学校，和简历上的读法一致。 */
const timeline = [
  {
    year: '2024 — 2026',
    text: 'Master of Digital Media',
    at: 'Northeastern University',
  },
  { year: '2021 —', text: 'Freelance: brand, illustration, tattoo design' },
  {
    year: '2019 — 2023',
    text: 'Bachelor of Fine Arts in Visual Communication',
    at: 'Communication University of Zhejiang',
  },
];

const revised = new Date().toISOString().slice(0, 10);
---

<Base title="Info — Red Thread">

  <section class="head-block">
    <div class="wrap">

      <div class="rail">
        <span>PRACTITIONER FILE</span>
        <span>RT-000</span>
        <span>TORONTO, ON</span>
        <span class="rail-end">REV. {revised}</span>
      </div>

      <div class="slug-line">
        <span class="ref">RT-000</span>
        <h1 class="title">Red Thread</h1>
        <span class="hash">#000</span>
      </div>

    </div>
  </section>

  <section class="section">
    <div class="wrap layout">

      <div class="col-main">
        <p class="prose reveal">
          Hi there — I&rsquo;m Red Thread. I design, paint, tattoo, and make games:
          a multi-hyphenate by passion.
        </p>

        <p class="prose reveal">
          With a Master&rsquo;s in Digital Media, I&rsquo;m exploring how
          traditional craft and modern technology collide to create <em>tension</em>,
          <em>contradiction</em>, and visual storytelling. My work lives somewhere
          between the tangible and the unreal, where myth, emotion, and data all
          intertwine.
        </p>

        <p class="prose reveal">
          I can help you turn abstract ideas into striking, story-driven visuals —
          whether it&rsquo;s brand design, illustration, or immersive media experiences
          that move people both visually and emotionally.
        </p>
      </div>

      <aside class="col-side">

        <div class="block reveal">
          <h2 class="section-label">Capacités</h2>
          <ul class="ledger">
            {capabilities.map((c, i) => (
              <li>
                <span class="ledger-n">{String(i + 1).padStart(2, '0')}</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="block reveal">
          <h2 class="section-label">Outils</h2>
          <ul class="ledger">
            {tools.map((t, i) => (
              <li>
                <span class="ledger-n">{String(i + 1).padStart(2, '0')}</span>
                <span>{t}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="block reveal">
          <h2 class="section-label">Chronologie</h2>
          <dl class="ledger">
            {timeline.map((t) => (
              <div>
                <dt class="ledger-n">{t.year}</dt>
                <dd>
                  {t.text}
                  {t.at && <span class="ledger-at">{t.at}</span>}
                </dd>
              </div>
            ))}
          </dl>
        </div>

      </aside>

    </div>
  </section>

</Base>

<style>
  .head-block {
    padding-top: clamp(7rem, 14vw, 11rem);
    padding-bottom: 0;
  }

  /* --- 抬头：跟项目页用同一套横栏和编号行 --- */

  .rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
    padding-block: 0.45rem;
    border-block: 1px solid var(--ink);
    border-bottom-width: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .rail-end { margin-left: auto; }

  .slug-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem clamp(0.9rem, 3vw, 2.5rem);
    padding-top: 0.5rem;
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    border-top: 1px solid var(--ink);
  }

  .ref, .hash {
    font-size: var(--step-2);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .hash { margin-left: auto; color: var(--red); }

  .title {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.012em;
    text-transform: uppercase;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .col-main > * + * { margin-top: 1.4rem; }

  .col-side > * + * { margin-top: clamp(2rem, 4vw, 3rem); }

  .block .section-label { margin-bottom: 0.9rem; }

  .ledger li,
  .ledger > div {
    display: grid;
    grid-template-columns: 6.6rem minmax(0, 1fr);   /* 放得下 2024 — 2026 */
    gap: 0.8rem;
    padding-block: 0.4rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--ink);
  }

  .ledger-n {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  .ledger dd { margin: 0; }

  /* 学校名压一档，学位才是这一行的主语 */
  .ledger-at {
    display: block;
    margin-top: 0.15em;
    color: var(--ink-soft);
    font-size: var(--step--2);
  }

  .ledger > div:first-child .ledger-n,
  .ledger li:first-child .ledger-n { color: var(--red); }

  /* 窄屏收成单栏 —— 两栏在手机上会把页面撑宽 */
  @media (max-width: 860px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .col-side { margin-top: clamp(2rem, 6vw, 3rem); }
  }

  @media (max-width: 480px) {
    .ledger li,
    /* 能力和工具是两位数编号，3.2rem 就够；
       时间线是「2024 — 2026」，得单独留宽一点，不然年份会折行。 */
    .ledger > div { grid-template-columns: 5.6rem minmax(0, 1fr); gap: 0.5rem; }
    .ledger li { grid-template-columns: 3.2rem minmax(0, 1fr); gap: 0.5rem; }
  }

</style>
