---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';

/* ── 这一页的内容全部在这里改，下面的模板不用动 ───────────────── */

/* Red Thread 是实践的名字，但求职这一页得有法定名字：
   招聘的人拿到简历之后会去搜，搜的是这个；作品集上找不到它，
   简历和网站就对不上号了。所以两个都给，大的是招牌，小的是本人。 */
const name = 'Jane Pu · 濮若菁';
/* 定位改成「品牌设计 + 营销」，跟简历一致。
   原来写的是 Interdisciplinary Visual Artist —— 跨度是真的，但求职这一页
   第一行要回答的是「你是干什么的」，而她现在投的是 design / marketing。
   跨度不丢，挪到下面第二段讲，那里才是它该在的位置。 */
const role = 'Brand Designer & Marketer';
const city = 'TORONTO, ON';

/* 技能分组照简历走：Brand & Identity / Marketing & Content / Tools。
   仍然是按「做什么」分组、不按「会什么软件」—— 招聘的人先找职能，
   软件是第二层；每组排满，整块读起来是一片密实的灰面，这是这一页的主体。
   原来是 Design / Technical / Software / Hand & Material 四组，偏作者向；
   简历那三组是招聘方按职能搜的词，两边得对得上号。

   .cols-4 是 auto-fit，三组自然成三栏，样式不用改。

   Hand & Material 那一组（纹身、海娜、水墨、装帧、定格……）撤了 ——
   简历上没有它。那组是真的差异点，想要的话随时加回来。 */
const skills = [
  {
    label: 'Brand & Identity',
    items: [
      'Brand & Visual Identity Systems',
      'Packaging Design',
      'Typography & Layout',
      'Illustration',
    ],
  },
  {
    label: 'Marketing & Content',
    items: [
      'Brand Strategy & Positioning',
      'Campaign & Launch Communication',
      'Art Direction',
      'Content Marketing',
      'Social Media Management',
      'Copywriting & Editing',
      'Competitive Analysis',
      'PR & Event Marketing',
    ],
  },
  {
    label: 'Tools',
    items: [
      'Photoshop',
      'Illustrator',
      'After Effects',
      'Premiere Pro',
      'Canva',
      'Figma',
      'Procreate',
      'Blender',
      'Unity',
      'HTML / CSS (Astro)',
      'AI-assisted Creation & Workflow',
    ],
  },
];

/* 经历照简历走：三条专业经历，和简历一字不差地对得上。
   原来这里有六条（角色设计、纹身、Muke 实习，而且 Zenith 和西南应用心理
   研究院分成两行）。简历把那两家并成了一条 —— 它们是一个集团下的两家公司，
   分开写反而像两份短工。

   href 指向作品集里对应的项目页。招聘的人读到 NUO2 那一行，
   下一步想干的事就是看这个项目，中间不该隔着一次「回首页再找」。

   Zenith 这条不写行业。简历上写的是 audit and legal firm，而站内
   Zenith 项目页跟的是手册，写的是工程造价咨询 / 全过程工程项目管理 ——
   把两种说法同时摆在一个站上，是肉眼可见的自相矛盾。
   数字（30% 认知、30 周年、20% 触达）全部照简历保留，只是不定性行业。 */
const experience = [
  {
    year: '2026 —',
    role: 'Digital Marketing Apprentice',
    at: 'Speakmo, voice-based social app · Toronto',
    /* 这条通到 Speakmo 的 TikTok 号 —— 它没有作品集页面，但那个号就是
       这份工作的成品本身，和 NUO2 点进项目页是同一个道理：
       读到这一行的人下一步想看的就是它。
       外链，所以箭头是 ↗ 不是 → —— 站内导航和跳出去不是一回事。 */
    href: 'https://www.tiktok.com/@realvoiceclips',
    external: true,
    note: 'Launched the organic content program on TikTok and Instagram from zero — 20+ short-form videos in the first six weeks, and the visual template that turns long-form audio into captioned, waveform-led clips. Weekly test-and-learn: the strongest format runs 4x the views of the weakest.',
  },
  {
    year: '2025 — 2026',
    role: 'Design Lead, Branding & Visual Identity (Contract)',
    at: 'Nuo-Oxygen (NUO2), premium craft rice-wine label · Vancouver',
    href: '/work/nuo2/',
    note: 'Repositioned a premium craft beverage from consumer research to retail launch, placing the range in 2 Beijing locations including a counter at Parkview Green. Built the identity system — logotype, typography, colour, illustration — and applied it across a 7-flavour, 8-SKU range plus gift sets, apparel and retail banners.',
  },
  {
    year: '2023 — 2024',
    role: 'Brand Designer & Creative Coordinator, and Social Media & Content Designer',
    at: 'Zenith Construction Engineering Management Co., Ltd · Chengdu',
    href: '/work/zenith/',
    note: 'Led a brand and visual identity upgrade that lifted brand recognition 30% among clients, and rolled it out at the firm’s 30th anniversary with event visuals and merchandise. Grew audience reach 20% at the group’s Southwest Institute of Applied Psychology, restructuring the content calendar and producing long-form learning content.',
  },
];

/* 简历新开的一节，摆在经历和学历之间。
   两条都有对应的项目页，所以两条都给链接。 */
const selectedWork = [
  {
    year: '2026',
    role: 'Single Artwork, “I Am a Maggot” by 3Bangz',
    at: 'Trendsetter Media · credited as Graphic Designer',
    href: '/work/i-am-a-maggot/',
    note: 'Cover and the 1080 × 1920 Spotify Canvas motion loop. Released on Spotify, NetEase Cloud Music and all major platforms.',
  },
  {
    year: '2026',
    role: '“Between Selves” — Experiential Activation',
    at: 'Balam Balam Place · Melbourne',
    href: '/work/between-selves/',
    note: 'Planned and promoted end to end: set the theme, brought in local artists, ran the print, install and invites. Engaged 150+ of 300+ attendees in 5 hours with 35+ custom designs.',
  },
];

/* 西南应用心理研究所公众号上发表的长文，她从调研、撰稿、排版做到信息图。
   这一节是上面 Zenith 那条「audience reach +20%」的实证 —— 数字写在经历里，
   证据放在这里。

   英文标题写的是那篇到底在论证什么，不是把中文标题直译过来：
   原标题是中文语境下的标题党（「社恐是病，得治！」），直译过去在
   英文简历页上读起来很轻浮，而内容本身是认真的科普。
   中文原题放在下面的小字里，一是中文读者认得出，二是点进去之前
   就知道目的地是中文 —— 不然一个多伦多的招聘方点开看到满屏中文会直接退回来。

   链接全部验证过能在浏览器里正常打开（抓取工具会被微信的风控挡在
   「环境异常」页，那只是数据中心 IP 的问题，访客不受影响）。 */
const published = [
  {
    year: '2024.05.05',
    role: 'Nonviolent communication, written as a formula',
    cn: '非暴力沟通：与人交流的万能公式',
    href: 'https://mp.weixin.qq.com/s/dKeJekhLCtAzhcnXhwNiEg',
  },
  {
    year: '2024.05.08',
    role: 'The lobotomy, and the Nobel Prize it won in 1949',
    cn: '诺贝尔奖居然也有「黑历史」？',
    href: 'https://mp.weixin.qq.com/s/OPO2mPvPFCCQCQP74zH3tQ',
  },
  {
    year: '2024.05.13',
    role: 'Sternberg’s three components, and the cost of over-giving',
    cn: '恋爱篇：爱自己才是终生浪漫',
    href: 'https://mp.weixin.qq.com/s/qcRXjcid_JCn1duwbsJ6RA',
  },
  {
    year: '2024.05.19',
    role: 'Body image anxiety, and what it is really about',
    cn: '身材焦虑：要挣脱的不止身体的枷锁',
    href: 'https://mp.weixin.qq.com/s/GAt1K3q3tdbb-e46DqN_TQ',
  },
  {
    year: '2024.05.27',
    role: 'How telephone fraud reads the person it is calling',
    cn: '世界电信日：从心理学角度解析防范电信诈骗',
    href: 'https://mp.weixin.qq.com/s/Y6EyfaOlTflGgwygKdJ_rA',
  },
  {
    year: '2024.06.17',
    role: 'Procrastination, and the time-self underneath it',
    cn: '我不是拖延症，我是考虑的比较周全',
    href: 'https://mp.weixin.qq.com/s/CE45ID8eI9iI2GC9ClrGmw',
  },
  {
    year: '2024.07.30',
    role: 'Social anxiety as a diagnosis rather than a meme',
    cn: '社恐是病，得治！',
    href: 'https://mp.weixin.qq.com/s/RRtXa3HPYgyV5-zIBpoYKA',
  },
];

const education = [
  { year: '2024 — 2026', text: 'Master of Digital Media', at: 'Northeastern University' },
  {
    year: '2019 — 2023',
    text: 'Bachelor of Fine Arts, Visual Communication',
    at: 'Communication University of Zhejiang',
  },
];

/* Between Selves 挪进 Selected Work 了（简历把它放在那一节），
   所以这里不再重复列它。留着这一节是因为参展本身是个独立的资历，
   简历一页放不下，站上放得下。 */
const showings = [
  { year: '2025', text: 'Vancouver Tattoo Convention', at: 'Vancouver' },
];

const languages = ['English', '中文'];

const revised = new Date().toISOString().slice(0, 10);
---

<Base title="Info — Red Thread">

  <section class="head-block">
    <div class="wrap">
      <div class="rail">
        <span>PRACTITIONER FILE</span>
        <span>RT-000</span>
        <span>{city}</span>
        <span class="rail-end">REV. {revised}</span>
      </div>

      <!-- 这一页的抬头就是一张标本卡：左边是标本，右边是它的登记信息。
           照片本身是作品 —— 脸被保鲜膜封在超市托盘里、贴着条码和价签。
           整站的说法是「卷宗／标本／编号」，这一份的标本是本人。
           已经抠干净了（51.6% 的像素全透明），所以托盘直接浮在纸上，
           不加框、不垫底、不用 multiply 那套障眼法。 -->
      <div class="id-block">
        <figure class="portrait">
          <Image
            src={portrait}
            alt="Self-portrait — the artist's face vacuum-packed in a supermarket tray, price label attached"
            widths={[420, 760, 1100]}
            sizes="(max-width: 760px) 62vw, 30vw"
            loading="eager"
          />
        </figure>

        <div class="id-text">
          <div class="slug-line">
            <span class="ref">RT-000</span>
            <h1 class="title">Red Thread</h1>
            <span class="hash">#000</span>
          </div>

          <p class="real-name">{name}</p>

          <!-- About 放在脸旁边。名字和元信息带之间原来是一段空白，
               而这段话正是「这张脸是谁」的答案，摆在这里才对得上。
               开场一句大、两段细节小并排 —— 一大一小，一栏一栏，
               和 protocol 抬头那条密排带是同一个道理。 -->
          <!-- 开场改成简历那句定位。原来写的是「跨学科视觉艺术家，
               开放于插画／概念设计／互动媒体」—— 和现在投的方向对不上。
               简历第一句给的是可核验的事实：两套完整识别系统、30%、20%、
               一张商业发行单曲的署名。这一页第一眼也该是这些。 -->
          <div class="id-about">
            <p class="lede">
              I'm a brand designer and marketer in Toronto, finishing a Master of Digital
              Media at Northeastern. I've built two complete visual identity systems from
              research through production — one onto retail shelves, one across a
              company's 30th anniversary — lifted brand recognition 30%, grew audience
              reach 20%, and hold credited artwork on a commercially released single.
            </p>
            <div class="id-detail">
              <p class="prose">
                I take a brand the whole way: research and positioning, the identity
                itself, then the campaign that launches it and the file that goes to the
                printer. The two halves are the same job to me — a system nobody sees is
                not finished, and a campaign with nothing behind it runs out in a week.
                I work bilingually in English and Chinese, which is most of why the NUO2
                range reads correctly on a shelf in Beijing.
              </p>
              <!-- 跨度没丢，挪到第二段。这里它是「我还能干什么」，
                   而不是「我是什么」—— 位置对了，它就是加分项不是杂音。 -->
              <p class="prose">
                Illustration is the spine of all of it, and the range around it runs from
                ink on handmade paper to a Unity build — printed books, tattoo, AR, card
                games. Everything else is that drawing pushed into another material until
                it has to hold up as a printed object, a playable system, or a mark on
                skin.
              </p>
            </div>
          </div>

          <!-- 元信息带。照片旁边原来只有三行字，右边 900px 空着。
               参考 protocol.studio：它的抬头是一整条密排的窄栏元信息，
               客户／服务／年份／职员表并排铺满整幅，全部 7–8px，没有一个大字。
               空间不是靠「大」填的，是靠「密」填的 —— 而密排小字正是这个站的母语。 -->
          <dl class="id-meta">
            <div>
              <dt>Role</dt>
              <dd>{role}</dd>
            </div>
            <div>
              <dt>Based</dt>
              <dd>Toronto, ON<br />Canada</dd>
            </div>
            <div>
              <dt>Languages</dt>
              <dd>{languages.join(' · ')}</dd>
            </div>
            <div>
              <dt>Contact</dt>
              <dd><a href="mailto:ruojingpu19@gmail.com">ruojingpu19@gmail.com</a></dd>
            </div>
            <div>
              <dt>Elsewhere</dt>
              <dd>
                <a href="https://www.linkedin.com/in/ruojing-pu-94067a33b/">LinkedIn ↗</a><br />
                <a href="https://www.instagram.com/luvsic707/">Instagram ↗</a><br />
                <!-- 标明是 Speakmo 的号，不是她个人号 —— 它和上面两个不是
                     同一类东西：那两个是「找她本人」，这个是「看她做的活」。
                     不标的话读起来就成了她自己的频道。
                     正因为是在职运营的账号，它反而是上面 Speakmo 那条经历
                     最硬的证据，所以留在这一页。 -->
                <a href="https://www.tiktok.com/@realvoiceclips">TikTok · Speakmo ↗</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">

      <!-- 板式照 protocol.studio 的 Information 页：
           标题在内容上方、底下一条横线（不是左标签右内容那种表单），
           一带并排两组，长名单拆成多栏变成块面，经历做成真正的表格。
           全页几乎一个字号，只有开场那段大一档 —— 一个例外，不是一套字阶。 -->

      <div class="band band-1 reveal">
        <section class="blk blk-skills">
          <h2 class="blk-head">Skills</h2>
          <div class="cols-4">
            {skills.map((g) => (
              <div>
                <h3 class="sub-head">{g.label}</h3>
                <ul class="plain">
                  {g.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </section>
      </div>

      <div class="band band-1 reveal">
        <section class="blk">
          <h2 class="blk-head">Experience</h2>
          <table class="tbl">
            <thead>
              <tr><th>Role</th><th>Organisation</th><th class="num">Year</th></tr>
            </thead>
            <tbody>
              {experience.map((e) => (
                <tr>
                  <td>
                    {e.href
                      ? <a
                          class="tbl-link"
                          href={e.href}
                          target={e.external ? '_blank' : undefined}
                          rel={e.external ? 'noopener noreferrer' : undefined}
                        >{e.role}<span class="tbl-go" aria-hidden="true">{e.external ? '↗' : '→'}</span></a>
                      : e.role}
                    <span class="tbl-note">{e.note}</span>
                  </td>
                  <td>{e.at}</td>
                  <td class="num">{e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>

      <!-- 简历新开的一节，位置也照简历：经历之后、学历之前。
           两条都通到作品页 —— 读到这里的人下一步就是想看作品。 -->
      <div class="band band-1 reveal">
        <section class="blk">
          <h2 class="blk-head">Selected Work</h2>
          <table class="tbl">
            <thead>
              <tr><th>Project</th><th>Where</th><th class="num">Year</th></tr>
            </thead>
            <tbody>
              {selectedWork.map((e) => (
                <tr>
                  <td>
                    {e.href
                      ? <a
                          class="tbl-link"
                          href={e.href}
                          target={e.external ? '_blank' : undefined}
                          rel={e.external ? 'noopener noreferrer' : undefined}
                        >{e.role}<span class="tbl-go" aria-hidden="true">{e.external ? '↗' : '→'}</span></a>
                      : e.role}
                    <span class="tbl-note">{e.note}</span>
                  </td>
                  <td>{e.at}</td>
                  <td class="num">{e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>

      <!-- 发表。摆在 Selected Work 和 Education 之间：它是职业产出，
           不是学历，而且紧跟在上面 Zenith 那条「+20% reach」后面，
           数字和证据挨着读。
           外链一律 target/rel —— 这七条是站外的，点开不该把访客从简历页带走。

           band-1 通栏，不用默认那个两栏栅格：三列里中间那列装中文原题，
           挤在左半边的话英文标题每条都要折两行，七条叠起来就成了一堵字墙。 -->
      <div class="band band-1 reveal">
        <section class="blk">
          <h2 class="blk-head">Published</h2>
          <p class="blk-lede">
            Long-form psychology features for the Southwest Institute of Applied
            Psychology, taken from research through copywriting, layout and
            infographics. Written in Chinese.
          </p>
          <table class="tbl">
            <thead>
              <tr><th>Piece</th><th>Original title</th><th class="num">Date</th></tr>
            </thead>
            <tbody>
              {published.map((e) => (
                <tr>
                  <td>
                    <a class="tbl-link" href={e.href} target="_blank" rel="noopener">
                      {e.role}<span class="tbl-go" aria-hidden="true">↗</span>
                    </a>
                  </td>
                  <td lang="zh">{e.cn}</td>
                  <td class="num">{e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>

      <div class="band reveal">
        <section class="blk">
          <h2 class="blk-head">Education</h2>
          <table class="tbl">
            <tbody>
              {education.map((e) => (
                <tr>
                  <td>{e.text}</td>
                  <td>{e.at}</td>
                  <td class="num">{e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section class="blk">
          <h2 class="blk-head">Showings</h2>
          <table class="tbl">
            <tbody>
              {showings.map((e) => (
                <tr>
                  <td>{e.text}</td>
                  <td>{e.at}</td>
                  <td class="num">{e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>

    </div>
  </section>

</Base>

<style>
  /* ==================== 板式 ====================
     protocol.studio 的 Information 页：标题在内容上方、底下一条横线，
     一带并排两组，长名单拆成多栏成为块面，经历是真正的表格。
     全页几乎一个字号，只有开场那段大一档。

     之前是「左标签、右内容」的表单式两栏 —— 那个读起来像申请表，
     不像文档，而且每一节的左边都钉着一个孤零零的小标签。 */

  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* 只有一组的带子（经历）自己占满 */
  .band-1 { grid-template-columns: minmax(0, 1fr); }

  @media (max-width: 860px) {
    .band { grid-template-columns: minmax(0, 1fr); }
  }

  /* 标题 + 它自己那条线。线只有这一组那么宽 —— 是它的边界，
     所以并排两组各有各的线，一眼看得出是两件事。 */
  .blk-head {
    margin: 0 0 clamp(1rem, 2.5vw, 1.75rem);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .blk > * + * { margin-top: 1rem; }
  .blk .lede + .prose { margin-top: clamp(1.25rem, 2.5vw, 1.75rem); }

  /* 整页唯一放大的一段 */
  .lede {
    max-width: 46ch;
    font-size: clamp(1.05rem, 0.8rem + 0.9vw, 1.45rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .blk .prose {
    max-width: 54ch;
    font-size: var(--step--1);
