---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.webp';

/* ── 这一页的内容全部在这里改，下面的模板不用动 ───────────────── */

/* Red Thread 是实践的名字，但求职这一页得有法定名字：
   招聘的人拿到简历之后会去搜，搜的是这个；作品集上找不到它，
   简历和网站就对不上号了。所以两个都给，大的是招牌，小的是本人。 */
const name = 'Xian Pu · 濮若菁';
/* 定位是「跨学科视觉艺术家」，不是某一个工种 —— 她的长处正是跨度。
   具体工种放到下面第一段里，招聘的人搜关键词照样搜得到。 */
const role = 'Interdisciplinary Visual Artist';
const city = 'TORONTO, ON';

/* 技能按「做什么」分组，不按「会什么软件」——
   招聘的人先找的是职能，软件是第二层。
   每组都排满，整块读起来是一片密实的灰面，这是这一页的主体。 */
const skills = [
  {
    label: 'Design',
    items: [
      'Illustration',
      'Concept Art',
      'Character Design',
      'Storyboarding',
      'Narrative Design',
      'Brand & Visual Identity',
      'Editorial & Book Design',
      'UI / UX Design',
      'Motion Graphics',
      '2D Animation',
    ],
  },
  {
    label: 'Technical',
    items: [
      'Unity (2D / AR)',
      'C#',
      'Vuforia',
      'Blender',
      'TouchDesigner',
      'Game Prototyping',
      'Usability Research',
      'AI-assisted Creation',
    ],
  },
  {
    label: 'Software',
    items: [
      'Photoshop',
      'Illustrator',
      'After Effects',
      'Premiere Pro',
      'Procreate',
      'Figma',
      'Unity',
      'Blender',
    ],
  },
  /* 这一组是别人没有的。放进技能表里，「杂」就变成了「跨度」。 */
  {
    label: 'Hand & Material',
    items: [
      'Tattooing',
      'Henna',
      'Chinese Ink',
      'Watercolour',
      'Mixed Media',
      'Bookbinding',
      'Stop-Motion',
      'Mural Painting',
      'Print Production',
    ],
  },
];

const experience = [
  {
    year: '2026 —',
    role: 'Character Design Artist',
    at: '2.5D Tactical Turn-Based Game · Vancouver',
    note: 'Progression-based character assets from sketch to in-engine; 3D blockout to 2D refinement at 31° isometric.',
  },
  {
    year: '2025 —',
    role: 'Independent Tattoo Artist',
    at: 'RedThread · Vancouver',
    note: 'Narrative-driven work. Showed at the 2025 Vancouver Tattoo Convention.',
  },
  {
    year: '2025 — 2026',
    role: 'Independent Branding Designer',
    at: 'Nuo-Oxygen Rice Wine · Remote',
    note: 'Full visual identity and a packaging system across 8 SKUs, gift sets, apparel and retail. In use in two stores.',
  },
  {
    year: '2024',
    role: 'Brand Designer & Creative Coordinator',
    at: 'Zenith Construction Engineering Management · Chengdu',
    note: 'Identity rebuild and brand manual, rolled out at the firm’s 30th anniversary.',
  },
  {
    year: '2023 — 2024',
    role: 'Social Media & Content Designer',
    at: 'Southwest Institute of Applied Psychology · Chengdu',
    note: 'Branding, long-form articles and infographics turning clinical material into public-facing work.',
  },
  {
    year: '2020',
    role: 'Illustrator Intern',
    at: 'Muke Cultural & Creative · Hangzhou',
    note: 'Two illustration series put into production; over 1,000 units sold.',
  },
];

const education = [
  { year: '2024 — 2026', text: 'Master of Digital Media', at: 'Northeastern University' },
  {
    year: '2019 — 2023',
    text: 'Bachelor of Fine Arts, Visual Communication',
    at: 'Communication University of Zhejiang',
  },
];

const showings = [
  {
    year: '2026',
    text: 'Between Selves · Flowing Through Identities',
    at: 'Balam Balam Place, Melbourne',
  },
  { year: '2025', text: 'Vancouver Tattoo Convention', at: 'Vancouver' },
];

const languages = ['English', '中文'];

const revised = new Date().toISOString().slice(0, 10);
---

<Base title="Info — Red Thread">

  <section class="head-block">
    <div class="wrap">
      <div class="rail">
        <span>PRACTITIONER FILE</span>
        <span>RT-000</span>
        <span>{city}</span>
        <span class="rail-end">REV. {revised}</span>
      </div>

      <!-- 这一页的抬头就是一张标本卡：左边是标本，右边是它的登记信息。
           照片本身是作品 —— 脸被保鲜膜封在超市托盘里、贴着条码和价签。
           整站的说法是「卷宗／标本／编号」，这一份的标本是本人。
           已经抠干净了（51.6% 的像素全透明），所以托盘直接浮在纸上，
           不加框、不垫底、不用 multiply 那套障眼法。 -->
      <div class="id-block">
        <figure class="portrait">
          <Image
            src={portrait}
            alt="Self-portrait — the artist's face vacuum-packed in a supermarket tray, price label attached"
            widths={[420, 760, 1100]}
            sizes="(max-width: 760px) 62vw, 30vw"
            loading="eager"
          />
        </figure>

        <div class="id-text">
          <div class="slug-line">
            <span class="ref">RT-000</span>
            <h1 class="title">Red Thread</h1>
            <span class="hash">#000</span>
          </div>

          <p class="real-name">{name}</p>

          <!-- About 放在脸旁边。名字和元信息带之间原来是一段空白，
               而这段话正是「这张脸是谁」的答案，摆在这里才对得上。
               开场一句大、两段细节小并排 —— 一大一小，一栏一栏，
               和 protocol 抬头那条密排带是同一个道理。 -->
          <div class="id-about">
            <p class="lede">
              I'm an interdisciplinary visual artist based in Toronto, finishing a Master
              of Digital Media at Northeastern. I'm open to work across illustration,
              concept art, visual and brand design, and interactive media.
            </p>
            <div class="id-detail">
              <p class="prose">
                Every project carries a commercial requirement and an idea of my own, and
                I look for the form that holds both — usually with a technology the brief
                did not come with. A sociology text becomes an ink series, clinical
                literature becomes an AR poster, a myth becomes a card game. I take a
                project the whole way: research, form, production, and the file that goes
                to the printer.
              </p>
              <p class="prose">
                The range runs from ink on handmade paper to a Unity build — illustration,
                brand systems, printed books, tattoo, AR, card games. Illustration is the
                spine of all of it: everything else is that drawing pushed into another
                material until it has to hold up as a printed object, a playable system,
                or a mark on skin.
              </p>
            </div>
          </div>

          <!-- 元信息带。照片旁边原来只有三行字，右边 900px 空着。
               参考 protocol.studio：它的抬头是一整条密排的窄栏元信息，
               客户／服务／年份／职员表并排铺满整幅，全部 7–8px，没有一个大字。
               空间不是靠「大」填的，是靠「密」填的 —— 而密排小字正是这个站的母语。 -->
          <dl class="id-meta">
            <div>
              <dt>Role</dt>
              <dd>{role}</dd>
            </div>
            <div>
              <dt>Based</dt>
              <dd>Toronto, ON<br />Canada</dd>
            </div>
            <div>
              <dt>Languages</dt>
              <dd>{languages.join(' · ')}</dd>
            </div>
            <div>
              <dt>Contact</dt>
              <dd><a href="mailto:ruojingpu19@gmail.com">ruojingpu19@gmail.com</a></dd>
            </div>
            <div>
              <dt>Elsewhere</dt>
              <dd>
                <a href="https://www.linkedin.com/in/ruojing-pu-94067a33b/">LinkedIn ↗</a><br />
                <a href="https://www.instagram.com/luvsic707/">Instagram ↗</a>
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">

      <!-- 板式照 protocol.studio 的 Information 页：
           标题在内容上方、底下一条横线（不是左标签右内容那种表单），
           一带并排两组，长名单拆成多栏变成块面，经历做成真正的表格。
           全页几乎一个字号，只有开场那段大一档 —— 一个例外，不是一套字阶。 -->

      <div class="band band-1 reveal">
        <section class="blk blk-skills">
          <h2 class="blk-head">Skills</h2>
          <div class="cols-4">
            {skills.map((g) => (
              <div>
                <h3 class="sub-head">{g.label}</h3>
                <ul class="plain">
                  {g.items.map((it) => <li>{it}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </section>
      </div>

      <div class="band band-1 reveal">
        <section class="blk">
          <h2 class="blk-head">Experience</h2>
          <table class="tbl">
            <thead>
              <tr><th>Role</th><th>Organisation</th><th class="num">Year</th></tr>
            </thead>
            <tbody>
              {experience.map((e) => (
                <tr>
                  <td>
                    {e.role}
                    <span class="tbl-note">{e.note}</span>
                  </td>
                  <td>{e.at}</td>
                  <td class="num">{e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>

      <div class="band reveal">
        <section class="blk">
          <h2 class="blk-head">Education</h2>
          <table class="tbl">
            <tbody>
              {education.map((e) => (
                <tr>
                  <td>{e.text}</td>
                  <td>{e.at}</td>
                  <td class="num">{e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <section class="blk">
          <h2 class="blk-head">Showings</h2>
          <table class="tbl">
            <tbody>
              {showings.map((e) => (
                <tr>
                  <td>{e.text}</td>
                  <td>{e.at}</td>
                  <td class="num">{e.year}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      </div>

    </div>
  </section>

</Base>

<style>
  /* ==================== 板式 ====================
     protocol.studio 的 Information 页：标题在内容上方、底下一条横线，
     一带并排两组，长名单拆成多栏成为块面，经历是真正的表格。
     全页几乎一个字号，只有开场那段大一档。

     之前是「左标签、右内容」的表单式两栏 —— 那个读起来像申请表，
     不像文档，而且每一节的左边都钉着一个孤零零的小标签。 */

  .band {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* 只有一组的带子（经历）自己占满 */
  .band-1 { grid-template-columns: minmax(0, 1fr); }

  @media (max-width: 860px) {
    .band { grid-template-columns: minmax(0, 1fr); }
  }

  /* 标题 + 它自己那条线。线只有这一组那么宽 —— 是它的边界，
     所以并排两组各有各的线，一眼看得出是两件事。 */
  .blk-head {
    margin: 0 0 clamp(1rem, 2.5vw, 1.75rem);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .blk > * + * { margin-top: 1rem; }
  .blk .lede + .prose { margin-top: clamp(1.25rem, 2.5vw, 1.75rem); }

  /* 整页唯一放大的一段 */
  .lede {
    max-width: 46ch;
    font-size: clamp(1.05rem, 0.8rem + 0.9vw, 1.45rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .blk .prose {
    max-width: 54ch;
    font-size: var(--step--1);
    line-height: 1.75;
    color: var(--ink-soft);
  }

  /* 名单拆成四栏 —— 一条长名单是细带，四栏并排是块面 */
  .cols-4 {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: clamp(0.9rem, 2vw, 1.75rem);
  }

  .sub-head {
    margin: 0 0 0.7em;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--2);
    line-height: 1.9;
    color: var(--ink);
  }

  .plain li::before { content: none; }

  /* 表格：每行一条线，年份靠右。说明跟在职位下面、退一档灰，
     所以扫一列就能读完职位，要细节再往下看。 */
  .tbl {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    color: var(--ink);
  }

  .tbl th {
    padding: 0 0 0.5rem;
    border-bottom: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ink-faint);
  }

  .tbl td {
    padding: clamp(0.7rem, 1.6vw, 1rem) 1rem clamp(0.7rem, 1.6vw, 1rem) 0;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }

  .tbl td:last-child, .tbl th:last-child { padding-right: 0; }

  .tbl .num {
    width: 7rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--ink-faint);
  }

  .tbl tbody tr:first-child .num { color: var(--red); }

  .tbl-note {
    display: block;
    margin-top: 0.45em;
    max-width: 52ch;
    font-size: var(--step--2);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .tbl, .tbl tbody, .tbl tr, .tbl td { display: block; width: 100%; }
    .tbl thead { display: none; }
    .tbl td { border: 0; padding: 0.15rem 0; }
    .tbl tr { padding-block: 0.9rem; border-bottom: 1px solid var(--line); }
  }

  .head-block {
    padding-top: clamp(7rem, 14vw, 11rem);
    padding-bottom: 0;
  }

  /* --- 抬头：跟项目页用同一套横栏和编号行 --- */

  .rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
    padding-block: 0.45rem;
    border-block: 1px solid var(--ink);
    border-bottom-width: 0;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .rail-end { margin-left: auto; }

  /* 标本卡：标本在左，登记信息在右、和照片顶边对齐。
     照片不设上限高度，宽度封在 360 —— 再大就压过后面的技能表，
     而技能表才是这一页的主体。 */
  .id-block {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    /* stretch 而不是 start：右栏撑满照片的高度，
       名字钉在顶、元信息带钉在底，中间那段空白于是有了两个端点。
       start 的话空白是挂在下面的，看着就是漏了一块。 */
    align-items: stretch;
    padding-top: clamp(1.25rem, 3vw, 2rem);
  }

  .id-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .portrait { margin: 0; }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 760px) {
    .id-block {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(1.25rem, 5vw, 2rem);
    }
    .portrait { max-width: 300px; }
  }

  .slug-line {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem clamp(0.9rem, 3vw, 2.5rem);
    padding-top: 0.5rem;
    border-top: 1px solid var(--ink);
  }

  /* 编号和井号压到最小、退成灰：它们是标记，不是内容。
     招牌一个人扛落差。 */
  .ref, .hash {
    font-size: var(--step--2);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
    padding-top: 0.9em;
  }

  .hash { margin-left: auto; color: var(--red); }

  /* 抬头空，是因为这里本来该有的那个「大」一直没给。
     22px 的招牌撑不住一整屏，右边自然就空成一块。 */
  .title {
    font-size: clamp(2rem, 1.1rem + 3.4vw, 4.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  /* About 在脸旁边：开场一句占一栏，两段细节占另一栏。
     名字钉顶、元信息带钉底，这一块填在中间，空白就没了。 */
  /* 开场句通栏，细节在它底下分两栏。
     一开始把开场句挤在半栏里，427px 装 23px 的字一行只有十八个字符，
     读起来像被掐着脖子 —— 大字要宽，这是它大的前提。 */
  .id-about { margin-top: clamp(1.5rem, 3.5vw, 2.5rem); }

  .id-detail {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    margin-top: clamp(1.25rem, 3vw, 2rem);
  }

  .id-detail > * + * { margin-top: 0; }

  .id-about .prose {
    max-width: none;
    font-size: var(--step--2);
    line-height: 1.8;
    color: var(--ink-soft);
  }

  @media (max-width: 860px) {
    .id-about { grid-template-columns: minmax(0, 1fr); }
  }

  /* ---- 元信息带 ----
     五条窄栏并排，全部 10px。密排是这个站的母语（页眉横栏、遥测块
     都是这么写的），所以这一条不是新东西，是把已有的说法用在该用的地方。
     自动填充：窄了就少几栏，不用另写断点。 */
  .id-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: clamp(0.9rem, 2vw, 1.75rem);
    margin: clamp(1.5rem, 3.5vw, 2.5rem) 0 0;
    padding-top: clamp(0.9rem, 2vw, 1.25rem);
    border-top: 1px solid var(--line);
  }

  .id-meta dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .id-meta dd {
    margin: 0.55em 0 0;
    font-size: var(--step--2);
    line-height: 1.7;
    color: var(--ink);
  }

  .id-meta a {
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.2s var(--ease);
  }

  .id-meta a:hover { border-bottom-color: var(--red); }

  /* 法定名字压一档，跟在招牌底下 —— 招牌是给人记的，名字是给人搜的 */
  .real-name {
    padding-top: 0.5rem;
    font-size: var(--step-0);
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  /* 职位行：让人两秒内知道这是干什么的，比任何一段自我介绍都先起作用 */
  .role {
    padding-top: 0.2rem;
    padding-bottom: clamp(1.5rem, 4vw, 2.5rem);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* ---- 整页的脊柱 ----
     每一节都是同一个两栏：左边一个小标签，右边内容。
     标签栏定宽，所以从 Statement 到 Languages，内容的左边缘是同一条线；
     节与节之间一条发丝线。一条边加一条线，密的地方有边界，
     空的地方也不再像漏了 —— 空白成了节奏的一部分，不是缺口。 */

  /* 第一节的横线留着 —— 抬头和正文之间也要有那条线，
     整页从上到下才是一串等距的横栏，而不是「一块抬头」加「一堆段落」。 */

  /* 标签和右边第一行内容对齐基线 —— 差一点点就看得出来 */


  /* 正文的行长自己管住，别因为右边宽了就拉成长条 */

  /* 开场那一句：大、占满内容栏，后面两段退回小字。
     一大一小，右边的空白就成了这句话的余量，不再是缺口。 */
  .lede {
    max-width: 30ch;
