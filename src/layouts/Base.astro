---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /* 分享到社交媒体时的预览图。传站内路径即可，这里会转成绝对地址。 */
  image?: string;
  /* 作品页是 article，首页等是 website */
  type?: 'website' | 'article';
}

const {
  title = 'Red Thread — Multidisciplinary Artist & Designer',
  description =
    'Design, illustration, tattoo, and games. Working where traditional craft and modern technology collide.',
  image,
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <!-- 带版本号：浏览器对 favicon 的缓存格外顽固，硬刷新都未必更新。
       换了图标就把这个数字 +1，所有人下次访问才会重新拉。 -->
  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..100,400..700&family=Fragment+Mono&display=swap"
  />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Red Thread" />
  {ogImage && <meta property="og:image" content={ogImage} />}

  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={ogImage} />}

  <meta name="theme-color" content="#F7F8F7" />
</head>

<body>
  <a href="#main" class="skip">Skip to content</a>

  <Nav />

  <main id="main">
    <slot />
  </main>

  <Footer />

  <script>
    // 滚动入场：元素进入视口时加 .is-in
    const items = document.querySelectorAll('.reveal');
    if (items.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
      );
      items.forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${Math.min(i, 6) * 55}ms`;
        io.observe(el);
      });
    }
  </script>

  <!-- ==================== 网格标尺 ====================
       按 G 开关。默认不存在，按了才建。

       做这个是因为「版面是不是歪的」光靠看和截图量不清楚 ——
       截图有缩放、裁切、窗口边框，误差比要找的偏移还大。
       这个尺子画在页面自己的坐标系里，一像素不差。

       画三样东西：
       · 左右两条红带 = 内容到视口边的真实距离，带数字
       · 蓝线 = 视口中线，绿线 = 内容中线，重合就是没歪
       · 灰竖线 = 版心被等分成 12 栏的位置，给以后排版用 -->
  <script>
    (() => {
      const ID = 'rt-ruler';

      const build = () => {
        const box =
          document.querySelector('.prose-body .band') ||
          document.querySelector('.prose-body [class^="rows-"]') ||
          document.querySelector('.prose-body .pair') ||
          document.querySelector('.wrap');
        if (!box) return;

        const b = box.getBoundingClientRect();
        const vw = document.documentElement.clientWidth;
        const L = Math.round(b.left);
        const R = Math.round(vw - b.right);

        const root = document.createElement('div');
        root.id = ID;
        root.style.cssText =
          'position:fixed;inset:0;z-index:99999;pointer-events:none;' +
          'font:11px/1.3 ui-monospace,Menlo,monospace';

        const add = (css, label) => {
          const d = document.createElement('div');
          d.style.cssText = 'position:absolute;top:0;height:100vh;' + css;
          if (label) d.textContent = label;
          root.append(d);
        };

        /* 两条红带：内容到视口边的真实距离 */
        add(`left:0;width:${b.left}px;background:rgba(200,16,46,.45);` +
            'color:#fff;padding:6px 8px;box-sizing:border-box', `左 ${L}`);
        add(`left:${b.right}px;width:${vw - b.right}px;background:rgba(200,16,46,.45);` +
            'color:#fff;padding:6px 8px;box-sizing:border-box;text-align:right', `右 ${R}`);

        /* 12 栏参考线 */
        for (let i = 1; i < 12; i++) {
          add(`left:${b.left + (b.width * i) / 12}px;width:1px;background:rgba(16,19,20,.18)`);
        }

        /* 视口中线（蓝）和内容中线（绿）—— 重合就是正的 */
        add(`left:${vw / 2 - 1}px;width:2px;background:#1a4fd8`);
        add(`left:${(b.left + b.right) / 2 - 1}px;width:2px;background:#0a8f3c`);

        /* 数字也写一份到控制台，方便直接复制 */
        console.log('[网格标尺]', {
          视口: vw, 内容左: L, 内容右: R, 内容宽: Math.round(b.width),
          偏移: Math.round((b.left + b.right) / 2 - vw / 2),
          量的是: box.className || box.tagName,
        });

        document.body.append(root);
      };

      const toggle = () => {
        const on = document.getElementById(ID);
        if (on) { on.remove(); return; }
        build();
      };

      addEventListener('keydown', (e) => {
        if (e.key !== 'g' && e.key !== 'G') return;
        const t = e.target as HTMLElement;
        if (t && /^(INPUT|TEXTAREA)$/.test(t.tagName)) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        toggle();
      });

      /* 开着的时候改窗口大小要跟着重画 */
      addEventListener('resize', () => {
        if (!document.getElementById(ID)) return;
        document.getElementById(ID)?.remove();
        build();
      });
    })();
  </script>

  <style>
    .skip {
      position: absolute;
      left: -9999px;
      top: 0;
      padding: 0.6rem 1rem;
      background: var(--ink);
      color: var(--paper);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      z-index: 100;
    }
    .skip:focus { left: 0; }
  </style>
</body>
</html>
