---
const path = Astro.url.pathname;
const isWork = path.startsWith('/work');
const isInfo = path.startsWith('/info');
---

<header class="nav" data-nav>
  <div class="nav-inner wrap">

    <a href="/" class="brand" aria-label="Red Thread Rehab — home">
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">RED&nbsp;THREAD</span>
      <span class="brand-sub">REHAB</span>
    </a>

    <nav class="links" aria-label="Main">
      <a href="/work" class:list={['link', 'mono', { on: isWork }]}>WORK</a>
      <a href="/info" class:list={['link', 'mono', { on: isInfo }]}>INFO</a>
    </nav>

  </div>
</header>

<script>
  const nav = document.querySelector('[data-nav]');

  if (nav) {
    /* ---- 什么时候浮出纸色 ----
       普通页面：往下滚一点就加底色和底线。

       作品页不一样：开屏是满屏的一整块，滚 24px 就横一条灰带过去，
       等于在作品脸上切一刀，而人还在看开屏。所以在作品页上改用
       正文那张纸当信号 —— 纸滑上来盖住开屏、顶到页头了，才浮色。 */
    const sheet = document.querySelector('.sheet');

    const onScroll = () => {
      const h = nav.getBoundingClientRect().height;
      const stuck = sheet
        ? sheet.getBoundingClientRect().top <= h
        : window.scrollY > 24;
      nav.classList.toggle('is-stuck', stuck);
    };

    /* 作品页的章节标签条钉到页头底下时，它自己就带一道边线 ——
       再画一条，两条平行的灰线夹出一条窄带。条自己会说话（rt:tabbed），
       页头只管收线。 */
    addEventListener('rt:tabbed', (e) => {
      nav.classList.toggle('has-tabs', !!(e as CustomEvent<boolean>).detail);
    });

    /* ---- 开屏是深色的怎么办 ----
       页头透明的时候，字是直接压在开屏上的。九命、等待戈多、for u
       这几件的开屏顶部接近纯黑，墨色的字压上去就看不见了。

       所以先问一句底下是什么：contain 的开屏两边留的是纸色，一定亮；
       cover 的开屏铺满，就取第一张图顶上那条真的算一次亮度。
       暗就把页头的字翻成浅色 —— 不是加一条底来保可读性，
       是让字适应它所在的地方。 */
    const gallery = document.querySelector('[data-gallery]');

    const measureTone = (src: CanvasImageSource, w: number, h: number) => {
      try {
        const c = document.createElement('canvas');
        c.width = 24;
        c.height = 6;
        const ctx = c.getContext('2d');
        if (!ctx) return;
        /* 只取最上面那 14% —— 页头压住的就是这一条 */
        ctx.drawImage(src, 0, 0, w, h * 0.14, 0, 0, 24, 6);
        const d = ctx.getImageData(0, 0, 24, 6).data;
        let sum = 0;
        for (let i = 0; i < d.length; i += 4) {
          sum += 0.2126 * d[i] + 0.7152 * d[i + 1] + 0.0722 * d[i + 2];
        }
        nav.classList.toggle('on-dark', sum / (d.length / 4) < 140);
      } catch {
        /* 取不到像素就当它是亮的，维持墨色 —— 宁可不翻，也不要翻错 */
      }
    };

    const readTone = () => {
      if (!gallery) return;
      if (gallery.classList.contains('is-contain')) return;   // 纸色打底，一定亮

      const img = gallery.querySelector('img');
      if (img instanceof HTMLImageElement) {
        if (img.complete && img.naturalWidth) measureTone(img, img.naturalWidth, img.naturalHeight);
        else img.addEventListener('load', readTone, { once: true });
        return;
      }

      /* 开屏是片子的项目（等待戈多、九命、for u）没有 img，只有 video。
         有 poster 就量 poster（不用等解码），没有就等第一帧出来直接量
         video 本身 —— canvas 画 video 和画 img 是一样的。

         只量一次，用开头那一帧定调子。这几件片子从头到尾都是暗的，
         跟着每一帧改会让页头的字一直在闪，那比看不清更糟。 */
      const video = gallery.querySelector('video');
      if (!(video instanceof HTMLVideoElement)) return;

      if (video.poster) {
        const probe = new Image();
        probe.onload = () => measureTone(probe, probe.naturalWidth, probe.naturalHeight);
        probe.src = video.poster;
        return;
      }

      if (video.readyState >= 2 && video.videoWidth) {
        measureTone(video, video.videoWidth, video.videoHeight);
      } else {
        video.addEventListener('loadeddata', readTone, { once: true });
      }
    };

    readTone();

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);

    // 把导航实测高度写进 --nav-h，供作品页的吸顶筛选器对齐。
    // 导航高度随字号变化，写死 rem 值在不同断点会错位。
    const measure = () => {
      document.documentElement.style.setProperty(
        '--nav-h',
        `${Math.round(nav.getBoundingClientRect().height)}px`
      );
    };
    measure();
    new ResizeObserver(measure).observe(nav);
  }
</script>

<style>
  /* 页头在最顶上时是完全透明的，标本从它底下穿过去 ——
     首屏是一整块，不该在顶上被一条底色带切一刀。
     一滚起来才浮出纸色和发丝线，那时候底下是正文，需要可读性。 */
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease),
                background 0.3s var(--ease),
                backdrop-filter 0.3s var(--ease);
    /* 整条不接事件，只有下面的品牌和链接接 ——
       这样首屏的互动范围真的是整屏，页头底下也能擦、也能转。 */
    pointer-events: none;
  }

  .nav.is-stuck {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(10px);
  }

  /* 底下钉着章节标签条的时候不画底线 —— 那条线在 35px 下面，
     标签条自己画。两条的话中间那一带像一行空表头。 */
  .nav.is-stuck.has-tabs { border-bottom-color: transparent; }

  /* 压在深色开屏上时字翻浅。纸色一浮出来就不需要了，收回墨色。 */
  .nav.on-dark:not(.is-stuck) .brand-name { color: var(--paper); }
  .nav.on-dark:not(.is-stuck) .brand-sub,
  .nav.on-dark:not(.is-stuck) .link { color: color-mix(in srgb, var(--paper) 72%, transparent); }
  .nav.on-dark:not(.is-stuck) .link:hover,
  .nav.on-dark:not(.is-stuck) .link.on { color: var(--paper); }

  .brand-name,
  .brand-sub,
  .link { transition: color 0.3s var(--ease); }

  .brand,
  .links { pointer-events: auto; }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  /* --- 品牌 --- */

  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* 品牌标记：一个中空的红圈。
     用 em 而不是 rem，这样它跟着字号走 —— 换字号时不用再调它。
     描边也用 em：圆变大时线跟着变粗，比例才不走形。 */
  .brand-mark {
    width: 0.86em;
    height: 0.86em;
    border: 0.16em solid var(--red);
    border-radius: 50%;
    flex: none;                      /* 别被 flex 压扁成椭圆 */
    box-sizing: border-box;          /* 描边算在尺寸里，否则会比实心那版大一圈 */
    transition: transform 0.35s var(--ease);
  }

  .brand:hover .brand-mark { transform: scale(1.25); }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-0);
    letter-spacing: 0.14em;
    color: var(--ink);
  }

  /* --- 链接 --- */

  .links {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    transition: color 0.2s var(--ease);
  }

  .glyph {
    font-size: 0.72em;
    color: var(--line-strong);
    transition: color 0.2s var(--ease), transform 0.3s var(--ease);
  }

  .link:hover,
  .link.on { color: var(--ink); }

  .link:hover .glyph,
  .link.on .glyph { color: var(--red); }

  .link:hover .glyph { transform: rotate(45deg); }
</style>
