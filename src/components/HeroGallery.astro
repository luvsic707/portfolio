---
import { Image } from 'astro:assets';

interface Slide {
  image?: ImageMetadata;
  video?: string;
  poster?: ImageMetadata;
  alt?: string;
}

interface Props {
  slides: Slide[];
  title: string;
}

const { slides, title } = Astro.props;
const hasVideo = slides.some((s) => s.video);
---

<section
  class="gallery"
  data-gallery
  data-interval="3500"
  aria-roledescription="carousel"
  aria-label={`${title} — gallery`}
>
  <div class="stage">
    {slides.map((s, i) => (
      <div
        class:list={['slide', { 'is-on': i === 0, 'is-video': !!s.video }]}
        data-slide
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} / ${slides.length}`}
      >
        {/* 背景是同一张图的模糊放大版，用来把留白填满 —— 前景仍然完整不裁切 */}
        {(s.image ?? s.poster) && (
          <Image
            class="bg"
            src={(s.image ?? s.poster)!}
            alt=""
            aria-hidden="true"
            widths={[64]}
            sizes="64px"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        )}

        {s.video ? (
          <video
            class="fg"
            data-video
            src={s.video}
            poster={s.poster?.src}
            muted
            playsinline
            preload={i === 0 ? 'auto' : 'none'}
            aria-label={s.alt ?? `${title} — video`}
          ></video>
        ) : s.image ? (
          <Image
            class="fg"
            src={s.image}
            alt={s.alt ?? title}
            widths={[720, 1280, 1920, 2400]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        ) : null}
      </div>
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button class="nav prev" data-prev type="button" aria-label="Previous">←</button>
      <button class="nav next" data-next type="button" aria-label="Next">→</button>

      <p class="counter mono" data-counter aria-live="polite">
        01 / {String(slides.length).padStart(2, '0')}
      </p>
    </>
  )}

  {hasVideo && (
    <button class="sound" data-sound type="button" aria-pressed="false" aria-label="Toggle sound">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
           fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <path d="M4 9.3h3.3L12 5.4v13.2L7.3 14.7H4z" fill="currentColor" stroke="none" />
        <g class="ico-off"><path d="M16.4 9.6l4.6 4.8M21 9.6l-4.6 4.8" /></g>
        <g class="ico-on"><path d="M16 9.2a4 4 0 0 1 0 5.6" /><path d="M18.7 6.8a7.6 7.6 0 0 1 0 10.4" /></g>
      </svg>
    </button>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length === 0) return;

    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const soundBtn = root.querySelector<HTMLButtonElement>('[data-sound]');
    const interval = Number(root.dataset.interval ?? 3500);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let index = 0;
    let timer: number | null = null;
    let paused = false;
    let soundOn = false;

    const videoIn = (el: HTMLElement) => el.querySelector<HTMLVideoElement>('[data-video]');

    const clearTimer = () => {
      if (timer !== null) { clearTimeout(timer); timer = null; }
    };

    /* 排下一次切换。视频那一格等它自己放完，不按固定秒数切断。 */
    const schedule = () => {
      clearTimer();
      if (paused || reduced || slides.length < 2) return;

      const v = videoIn(slides[index]);
      if (v) return;                       // 视频结束时会自己触发 next
      timer = window.setTimeout(() => go(index + 1), interval);
    };

    const go = (next: number) => {
      const to = (next + slides.length) % slides.length;

      slides.forEach((s, i) => {
        const on = i === to;
        s.classList.toggle('is-on', on);
        const v = videoIn(s);
        if (!v) return;
        if (on) {
          v.muted = !soundOn;
          v.currentTime = 0;
          v.play().catch(() => {/* 自动播放被拦就算了，用户点一下就行 */});
        } else {
          v.pause();
        }
      });

      /* 声音开关只在视频那一格出现，别挂在图片上碍事 */
      root.classList.toggle('on-video', !!videoIn(slides[to]));

      if (counter) {
        counter.textContent =
          `${String(to + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
      }

      index = to;
      schedule();
    };

    /* 视频放完自动进下一张 */
    slides.forEach((s) => {
      const v = videoIn(s);
      v?.addEventListener('ended', () => { if (!paused) go(index + 1); });
    });

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));

    /* 声音：浏览器不允许带声自动播放，所以默认静音 + 一个开关 */
    soundBtn?.addEventListener('click', () => {
      soundOn = !soundOn;
      soundBtn.setAttribute('aria-pressed', String(soundOn));
      const v = videoIn(slides[index]);
      if (v) {
        v.muted = !soundOn;
        if (soundOn) v.play().catch(() => {});
      }
    });

    /* 只有停在控件上才暂停 —— 画面是满屏的，停在画面上就暂停等于永不轮播 */
    root.querySelectorAll<HTMLElement>('.nav, .sound').forEach((el) => {
      el.addEventListener('pointerenter', () => { paused = true; clearTimer(); });
      el.addEventListener('pointerleave', () => { paused = false; schedule(); });
    });

    /* 触屏左右滑 */
    let x0: number | null = null;
    root.addEventListener('pointerdown', (e) => { x0 = e.clientX; }, { passive: true });
    root.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 45) go(index + (dx < 0 ? 1 : -1));
    }, { passive: true });

    /* 键盘左右键（画廊在视野里时才响应） */
    let visible = true;
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) schedule(); else clearTimer();
    }).observe(root);

    document.addEventListener('keydown', (e) => {
      if (!visible) return;
      if (e.key === 'ArrowLeft') go(index - 1);
      if (e.key === 'ArrowRight') go(index + 1);
    });

    /* 起播 */
    root.classList.toggle('on-video', !!videoIn(slides[0]));
    const first = videoIn(slides[0]);
    if (first) first.play().catch(() => {});
    schedule();
  });
</script>

<style>
  .gallery {
    position: relative;
    width: 100%;
    padding-top: var(--nav-h, 3.4rem);
    background: var(--paper-sunk);
    overflow: hidden;
    touch-action: pan-y;
  }

  /* 开屏铺满一整屏 —— 导航条以下全给作品 */
  .stage {
    position: relative;
    width: 100vw;
    height: calc(100svh - var(--nav-h, 3.4rem));
  }

  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s var(--ease);
    pointer-events: none;
    background: var(--paper-sunk);
    overflow: hidden;
  }

  .slide.is-video { background: #08080a; }

  .slide.is-on { opacity: 1; pointer-events: auto; }

  /* 背景层：同一张图放大模糊，把上下留白填掉，观感是满的 */
  .slide :global(img.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(38px) saturate(1.15) brightness(0.9);
    transform: scale(1.12);
    z-index: 0;
  }

  /* 前景层：作品本身，完整呈现，一寸都不裁 */
  .slide :global(img.fg),
  .slide video.fg {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  /* --- 左右箭头 --- */

  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: #fff;
    mix-blend-mode: difference;
    background: none;
    border: 0;
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .prev { left: clamp(0.5rem, 2vw, 1.5rem); }
  .next { right: clamp(0.5rem, 2vw, 1.5rem); }

  .gallery:hover .nav { opacity: 0.55; }
  .nav:hover, .nav:focus-visible { opacity: 1; }

  /* 触屏没有 hover，箭头淡淡地常驻 */
  @media (hover: none) {
    .nav { opacity: 0.4; }
  }

  /* --- 页码 ---
     不做进度条：只留一个极轻的页码，鼠标进来才浮现。
     mix-blend-mode 让它在深色浅色画面上都读得清，不用垫底色块。 */

  .counter {
    position: absolute;
    right: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.4rem);
    z-index: 3;
    color: #fff;
    mix-blend-mode: difference;
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    font-variant-numeric: tabular-nums;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
    pointer-events: none;
  }

  .gallery:hover .counter { opacity: 0.5; }

  @media (hover: none) {
    .counter { opacity: 0.35; }
  }

  /* --- 声音开关 ---
     只在视频那一格出现，纯图标、无边框、无底色，不抢构图。 */

  .sound {
    position: absolute;
    left: clamp(0.75rem, 2vw, 1.5rem);
    bottom: clamp(0.75rem, 2vw, 1.4rem);
    z-index: 4;
    display: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    mix-blend-mode: difference;
    opacity: 0.4;
    transition: opacity 0.25s var(--ease);
  }

  .gallery.on-video .sound { display: grid; }

  .sound:hover,
  .sound:focus-visible { opacity: 1; }

  .sound[aria-pressed='true'] { opacity: 0.85; }

  .sound .ico-on { display: none; }
  .sound[aria-pressed='true'] .ico-off { display: none; }
  .sound[aria-pressed='true'] .ico-on { display: inline; }

  @media (max-width: 640px) {
    .nav { width: 2.4rem; height: 2.4rem; }
  }
</style>
