---
import { getCollection } from 'astro:content';

const year = new Date().getFullYear();

/* 横栏里的数字必须是真的 —— 编出来的档案数据一眼就假。
   卷宗数取自内容集合，修订日期取自构建时间。 */
const cases = (await getCollection('projects')).filter((p) => !p.data.draft).length;
const revised = new Date().toISOString().slice(0, 10);

/* 联系方式 —— 改这里就行 */
const email = 'ruojingpu19@gmail.com';

/* 社交链接 —— 加一行就多一个，删一行就少一个 */
const links = [
  { label: 'EMAIL',     href: `mailto:${email}` },
  { label: 'INSTAGRAM', href: 'https://www.instagram.com/luvsic707/' },
  // { label: 'BEHANCE', href: 'https://www.behance.net/你的用户名' },
];
---

<footer class="foot">
  <div class="wrap">
    <hr class="rule" />

    <div class="foot-grid">

      <div class="foot-say">
        <p class="say-line mono">Enquiries · Commissions · Collaborations</p>
        <a class="say-mail" href={`mailto:${email}`}>{email}</a>
      </div>

      <ul class="foot-links">
        {links.map((l) => (
          <li>
            <a
              class="foot-link mono"
              href={l.href}
              target={l.href.startsWith('http') ? '_blank' : undefined}
              rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {l.label}<span class="arrow">↗</span>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </div>

  <!-- 页脚横栏：跟项目页页眉同一个格式。字段永远这几个，值变、位置不变。 -->
  <div class="foot-rail">
    <div class="wrap foot-rail-inner">
      <span>RED THREAD REHAB</span>
      <span>{cases} CASES ON FILE</span>
      <span>REV. {revised}</span>
      <span class="foot-rail-end">© {year}</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding-block: clamp(3rem, 7vw, 6rem) 2.5rem;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }

  .say-line {
    color: var(--ink-soft);
    letter-spacing: 0.08em;
    text-transform: none;
  }

  .say-mail {
    display: inline-block;
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--step-2);
    letter-spacing: -0.01em;
    background-image: linear-gradient(var(--red), var(--red));
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s var(--ease), color 0.3s var(--ease);
  }

  .say-mail:hover {
    color: var(--red);
    background-size: 100% 1px;
  }

  .foot-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: right;
  }

  .foot-link {
    letter-spacing: 0.14em;
    transition: color 0.2s var(--ease);
  }

  .foot-link:hover { color: var(--red); }

  .arrow {
    display: inline-block;
    margin-left: 0.4em;
    color: var(--line-strong);
    transition: transform 0.25s var(--ease), color 0.2s var(--ease);
  }

  .foot-link:hover .arrow {
    color: var(--red);
    transform: translate(2px, -2px);
  }

  /* --- 页脚横栏 --- */

  .foot-rail {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    border-top: 1px solid var(--ink);
  }

  .foot-rail-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.6rem;
    padding-block: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--ink-faint);
  }

  .foot-rail-end { margin-left: auto; }

  @media (max-width: 560px) {
    .foot-rail-end { margin-left: 0; }
  }

  @media (max-width: 640px) {
    .foot-grid { grid-template-columns: 1fr; }
    .foot-links { text-align: left; }
  }
</style>
