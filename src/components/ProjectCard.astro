---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, year, categories, summary, cover, coverAlt } = project.data;

/* 卷宗编号跟项目页保持同一套：RT-<slug 首字母>-<序号> */
const caseNo = String(project.data.order ?? index + 1).padStart(3, '0');
const initials = project.id.split('-').map((w) => w[0]).join('').toUpperCase().slice(0, 3);
const ref = `RT-${initials}-${caseNo}`;
---

<article class="card reveal">
  <a class="card-hit" href={`/work/${project.id}`}>

    <!-- 抬头横栏：编号 / 年份，跟项目页的页眉同一个格式 -->
    <div class="card-rail">
      <span class="card-ref">{ref}</span>
      <span class="card-year">{year}</span>
    </div>

    <div class="card-media">
      {cover ? (
        <Image
          src={cover}
          alt={coverAlt ?? title}
          widths={[400, 640, 900]}
          sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="card-empty"><span class="mono">NO PLATE ON FILE</span></div>
      )}
    </div>

    <div class="card-body">
      <h3 class="card-title">{title}</h3>
      <p class="card-sum">{summary}</p>

      <dl class="card-spec">
        <dt>Catégorie</dt>
        <dd>{categories.join(' / ')}</dd>
      </dl>
    </div>

  </a>
</article>

<style>
  .card-hit { display: block; }

  /* --- 图 --- */

  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-sunk);
    border: 1px solid var(--line);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease), filter 0.5s var(--ease);
  }

  .card-hit:hover .card-media img {
    transform: scale(1.035);
  }

  .card-empty {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--ink-faint);
    letter-spacing: 0.16em;
  }

  /* --- 抬头横栏：编号在左，年份在右，发丝线压底 --- */

  .card-rail {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.3rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  .card-hit:hover .card-ref { color: var(--red); }

  .card-ref { transition: color 0.25s var(--ease); }

  /* --- 文字 --- */

  .card-body { padding-top: 0.75rem; }

  .card-title {
    font-weight: 600;
    font-size: var(--step-0);
    line-height: 1.25;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    transition: color 0.25s var(--ease);
  }

  .card-hit:hover .card-title { color: var(--red); }

  .card-sum {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  /* --- 规格行：标签在上，值在下，跟卷宗表一个读法 --- */

  .card-spec {
    margin-top: 0.9rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--line);
  }

  .card-spec dt {
    font-size: var(--step--2);
    font-stretch: var(--cond);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .card-spec dd {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink);
  }

  .card-hit:hover .card-spec { border-top-color: var(--line-strong); }
</style>
